---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Lineup from '../components/Lineup.astro';
import { bySlug } from '../data/projects';
import { site } from '../data/site';

const codex = bySlug('codex-saltus')!;
const changa = bySlug('changa-crew')!;
const tribe = bySlug('trance-tribe')!;
const shik = bySlug('shikingim')!;
const metaLine = (p: typeof codex) => `${p.client ?? ''} — ${p.discipline[0]}, ${p.year.replace(' — ', '–')}`;
---
<Base>
  <!-- HERO -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__top label">
      <span>{site.role} — {site.location}</span>
      <span class="hero__years">Selected work 2024–2026</span>
    </div>
    <h1 id="hero-title" class="mega hero__name">
      <span class="hero__line"><span>Or Asif-</span></span><span class="hero__line"><span>Haber</span></span>
    </h1>
    <div class="hero__bottom">
      <p class="hero__statement">
        I build the visual worlds around psytrance parties, record labels and artists — line-up posters,
        party branding and cover art — and brand identities beyond the dance floor.
      </p>
      <ul class="hero__cta">
        <li><a href="#work" class="label link">Selected work <span class="arrow" aria-hidden="true">↓</span></a></li>
        <li><a href="#contact" class="label link">Get in touch <span class="arrow" aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </section>

  <!-- 01 — zoom into the lead project -->
  <section id="work" class="zoom" aria-label="Selected work">
    <h2 class="sr-only">Selected work</h2>
    <a href={`/work/${codex.slug}/`} class="zoom__sticky" aria-label={`${codex.title} — ${codex.subtitle}`}>
      <div class="zoom__frame">
        <Img id={codex.hero.id} alt={codex.hero.alt} reveal={false} sizes="100vw" ratio="auto" class="zoom__img" />
      </div>
      <div class="zoom__caption wrap">
        <span class="label">01</span>
        <span class="display zoom__title" transition:name={`title-${codex.slug}`}>{codex.title}</span>
        <span class="label">{metaLine(codex)} <span class="arrow" aria-hidden="true">→</span></span>
      </div>
    </a>
  </section>

  <!-- 02 — Changa Crew -->
  <section class="feat feat--changa wrap grid" style={`--fa:${changa.accent}`}>
    <a href={`/work/${changa.slug}/`} class="feat__main" tabindex="-1" aria-hidden="true">
      <Img id="02/01" alt="" sizes="(min-width: 900px) 56vw, 92vw" />
    </a>
    <div class="feat__text">
      <p class="label">02</p>
      <h3 class="display feat__title"><a href={`/work/${changa.slug}/`} transition:name={`title-${changa.slug}`}>{changa.title}</a></h3>
      <p class="label">{metaLine(changa)}</p>
      <p class="muted feat__desc">Two anniversary parties, two worlds — a Russian underground edition with bears at the synths, and a tribal one-year celebration on swirling parchment.</p>
      <a href={`/work/${changa.slug}/`} class="label link">View project <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <a href={`/work/${changa.slug}/`} class="feat__aside" tabindex="-1" aria-hidden="true">
      <Img id="05/03" alt="" sizes="(min-width: 900px) 26vw, 46vw" i={1} />
    </a>
  </section>

  <!-- 03 — Trance Tribe -->
  <section class="feat feat--tribe" style={`--fa:${tribe.accent}`}>
    <div class="wrap feat__head">
      <p class="label">03</p>
      <h3 class="display feat__title"><a href={`/work/${tribe.slug}/`} transition:name={`title-${tribe.slug}`}>{tribe.title}</a></h3>
      <p class="label">{metaLine(tribe)}</p>
    </div>
    <a href={`/work/${tribe.slug}/`} class="feat__wide" tabindex="-1" aria-hidden="true">
      <Img id="09/01" alt="" sizes="100vw" />
    </a>
    <div class="wrap grid feat__foot">
      <a href={`/work/${tribe.slug}/`} class="feat__s1" tabindex="-1" aria-hidden="true"><Img id="09/02" alt="" sizes="(min-width: 900px) 33vw, 92vw" /></a>
      <a href={`/work/${tribe.slug}/`} class="feat__s2" tabindex="-1" aria-hidden="true"><Img id="09/08" alt="" sizes="(min-width: 900px) 33vw, 92vw" i={1} /></a>
      <div class="feat__text feat__text--tribe">
        <p class="muted feat__desc">My final project at Ariel University: a black-and-white identity for a psychedelic merchandise &amp; fashion brand — products, packaging, an event app and web.</p>
        <a href={`/work/${tribe.slug}/`} class="label link">View project <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 04 — Shikingim -->
  <section class="feat feat--shik wrap" style={`--fa:${shik.accent}`}>
    <div class="feat__head feat__head--center">
      <p class="label">04</p>
      <h3 class="display feat__title"><a href={`/work/${shik.slug}/`} transition:name={`title-${shik.slug}`}>{shik.title}</a></h3>
      <p class="label">{metaLine(shik)}</p>
    </div>
    <a href={`/work/${shik.slug}/`} class="feat__trio" tabindex="-1" aria-hidden="true">
      <Img id="04/01" alt="" sizes="(min-width: 700px) 30vw, 46vw" class="t1" />
      <Img id="03/01" alt="" sizes="(min-width: 700px) 30vw, 46vw" class="t2" i={1} />
      <Img id="03/03" alt="" sizes="(min-width: 700px) 30vw, 46vw" class="t3" i={2} />
    </a>
    <div class="feat__text feat__text--center">
      <p class="muted feat__desc">A recurring series for Shikingim productions — each edition a new landscape and cast, the same mark and poster structure.</p>
      <a href={`/work/${shik.slug}/`} class="label link">View project <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <Lineup />

  <!-- ABOUT preview -->
  <section class="about-pre section wrap grid" aria-labelledby="about-pre-title">
    <h2 id="about-pre-title" class="label about-pre__label">About</h2>
    <div class="about-pre__body">
      <p class="lead" data-reveal>
        Graphic designer and Visual Communication graduate (Ariel University), freelancing since 2024.
        I work directly with clients from the brief to final delivery — shaping the creative direction,
        designing, revising — including repeat work for StoneAge Records, a Swedish psytrance label.
      </p>
      <a href="/about/" class="label link" data-reveal style="--i:1">More about me <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="about-pre__with">
      <p class="label">Worked with</p>
      <ul class="about-pre__list" role="list">
        {site.workedWith.map((w, n) => <li data-reveal style={`--i:${n}`}>{w}</li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { min-height: 0; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-6); padding-top: 88px; padding-bottom: var(--s-8); }
  .hero__top { display: flex; justify-content: space-between; gap: var(--s-4); }
  .hero__years { display: none; }
  .hero__name { margin-left: -0.045em; font-size: 22vw; }
  @media (min-width: 900px) { .hero { min-height: 72svh; } }
  @media (min-width: 700px) {
    .hero__name { font-size: 16.4vw; display: flex; white-space: nowrap; }
    .hero__line + .hero__line { margin-left: 0; }
  }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.02em; }
  .hero__line > span { display: block; }
  .hero__bottom { display: grid; gap: var(--s-5); }
  .hero__statement { font-size: clamp(1.25rem, 2.3vw, 2.2rem); line-height: 1.22; letter-spacing: -0.015em; max-width: 30ch; font-variation-settings: 'wdth' 92; }
  .hero__cta { display: flex; gap: var(--s-6); }
  @media (min-width: 900px) {
    .hero__years { display: inline; }
    .hero__bottom { grid-template-columns: 1fr auto; align-items: end; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span { animation: rise 1.1s var(--ease-out) both; }
    .hero__line:nth-child(2) > span { animation-delay: 90ms; }
    .hero__bottom, .hero__top { animation: fade 1s 350ms var(--ease-out) both; }
    @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
    @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  }

  /* ---------- zoom ---------- */
  .zoom { position: relative; }
  .zoom__sticky { display: block; position: relative; color: #fff; }
  .zoom__frame { overflow: hidden; }
  .zoom :global(.zoom__img) { aspect-ratio: 2420 / 1896; }
  .zoom__caption {
    position: absolute; inset: auto 0 0 0; display: grid; gap: var(--s-2);
    padding-block: var(--s-9) var(--s-5);
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), transparent);
  }
  .zoom__caption .label { color: rgb(255 255 255 / 0.86); }
  @media (max-width: 899px) {
    .zoom__caption { position: static; background: none; padding-block: var(--s-5) 0; }
    .zoom__caption .label { color: var(--ink-2); }
    .zoom__sticky { color: var(--ink); }
  }
  .zoom__title { transition: color var(--d-base) var(--ease-out); }
  .zoom__sticky:hover .zoom__title, .zoom__sticky:focus-visible .zoom__title { color: var(--signal); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
      .zoom { height: 200svh; view-timeline: --zoom block; }
      .zoom__sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; }
      .zoom__frame { position: absolute; inset: 0; animation: unmask linear both; animation-timeline: --zoom; animation-range: entry 40% contain 45%; }
      .zoom :global(.zoom__img) { aspect-ratio: auto; height: 100%; }
      .zoom :global(.zoom__img img) { object-position: 50% 12%; }
      .zoom :global(.zoom__img img) { animation: settle linear both; animation-timeline: --zoom; animation-range: entry 40% contain 45%; }
      .zoom__caption { animation: cap linear both; animation-timeline: --zoom; animation-range: contain 25% contain 50%; }
      @keyframes unmask { from { clip-path: inset(14% 22% 14% 22%); } to { clip-path: inset(0 0 0 0); } }
      @keyframes settle { from { transform: scale(1.18); } to { transform: scale(1); } }
      @keyframes cap { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    }
  }

  /* ---------- featured ---------- */
  .feat { padding-top: var(--section); }
  .feat__title a { transition: color var(--d-base) var(--ease-out); }
  .feat__title a:hover, .feat__title a:focus-visible { color: var(--fa); }
  .feat__text { display: grid; gap: var(--s-4); align-content: start; }
  .feat__desc { max-width: 40ch; }
  .feat :global(.media) { transition: filter var(--d-base) var(--ease-out); }
  .feat a:hover :global(img) { transform: scale(1.025); }
  .feat :global(img) { transition: transform 1.2s var(--ease-out); }

  .feat--changa { row-gap: var(--s-6); }
  :where(.feat--changa > *) { grid-column: 1 / -1; }
  .feat--changa .feat__aside { grid-column: 5 / -1; }
  @media (min-width: 900px) {
    .feat--changa .feat__main { grid-column: 1 / span 7; grid-row: 1 / span 2; }
    .feat--changa .feat__text { grid-column: 9 / span 4; grid-row: 1; padding-top: var(--s-6); }
    .feat--changa .feat__aside { grid-column: 9 / span 3; grid-row: 2; align-self: end; }
  }

  .feat--tribe .feat__head { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); }
  .feat__wide { display: block; }
  .feat__foot { row-gap: var(--s-6); margin-top: var(--gutter); }
  :where(.feat__foot > *) { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .feat--tribe .feat__head { grid-template-columns: 4rem 1fr auto; align-items: end; column-gap: var(--gutter); }
    .feat__s1 { grid-column: 1 / span 4; }
    .feat__s2 { grid-column: 5 / span 4; margin-top: var(--s-9); }
    .feat__text--tribe { grid-column: 10 / span 3; align-self: end; }
  }

  .feat--shik .feat__head--center { display: grid; gap: var(--s-3); justify-items: center; text-align: center; margin-bottom: var(--s-7); }
  .feat__trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); align-items: start; }
  .feat__trio :global(.t1), .feat__trio :global(.t3) { margin-top: 22%; }
  .feat__text--center { justify-items: center; text-align: center; margin-top: var(--s-7); }
  @media (max-width: 699px) {
    .feat__trio { grid-template-columns: 1fr 1fr; }
    .feat__trio :global(.t3) { display: none; }
    .feat__trio :global(.t1) { margin-top: 0; }
    .feat__trio :global(.t2) { margin-top: 18%; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 700px) {
      .feat__trio :global(.t2) { animation: drift linear both; animation-timeline: view(); animation-range: cover; }
      @keyframes drift { from { translate: 0 10%; } to { translate: 0 -10%; } }
    }
  }

  /* ---------- about preview ---------- */
  .about-pre { row-gap: var(--s-6); border-top: 1px solid var(--line); }
  :where(.about-pre > *) { grid-column: 1 / -1; }
  .about-pre__body { display: grid; gap: var(--s-5); max-width: 860px; }
  .about-pre__list { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-3); font-weight: 700; font-variation-settings: 'wdth' 62; text-transform: uppercase; font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1; }
  .about-pre__list li:not(:last-child)::after { content: '/'; margin-left: var(--s-5); color: var(--ink-3); font-weight: 400; }
  @media (min-width: 900px) {
    .about-pre__label { grid-column: 1 / span 3; padding-top: 0.6em; }
    .about-pre__body, .about-pre__with { grid-column: 4 / span 9; }
  }
</style>
