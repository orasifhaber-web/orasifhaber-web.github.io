---
// /work/<slug>/ serves both the project pages and the category pages (slugs never collide — see data/projects.ts).
import ProjectPage from '../../../views/ProjectPage.astro';
import CategoryPage from '../../../views/CategoryPage.astro';
import { projects, categories, type Project, type Category } from '../../../data/projects';

export const getStaticPaths = () => [
  ...projects.map((p) => ({ params: { slug: p.slug }, props: { p } })),
  ...categories.map((c) => ({ params: { slug: c.slug }, props: { c } })),
];
const { p, c } = Astro.props as { p?: Project; c?: Category };
---
{p ? <ProjectPage lang="en" p={p} /> : <CategoryPage lang="en" c={c!} />}
