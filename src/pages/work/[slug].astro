---
import '@fontsource/pirata-one/400.css';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Blocks from '../../components/Blocks.astro';
import { projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p, n) => ({
    params: { slug: p.slug },
    props: { p, n, next: projects[(n + 1) % projects.length], prev: projects[(n - 1 + projects.length) % projects.length] },
  }));
}
interface Props { p: Project; n: number; next: Project; prev: Project }
const { p, n, next, prev } = Astro.props;

const meta = [
  ['Client', p.client ?? '—'],
  ['Year', p.year],
  ['Discipline', p.discipline.join(', ')],
  ['Tools', p.tools.join(', ')],
];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.title,
  description: p.subtitle,
  creator: { '@type': 'Person', name: site.name },
  dateCreated: p.year.slice(0, 4),
  image: new URL(`/img/${p.hero.id}-1280.webp`, Astro.site).toString(),
  keywords: p.discipline.join(', '),
};
---
<Base title={p.title} description={`${p.subtitle}. ${p.intro[0]}`.slice(0, 158)} image={`/img/${p.hero.id}-1280.webp`} accent={p.accent} jsonld={jsonld} type="article">
  <article class="project">
    <header class="p-hero wrap">
      <nav class="p-hero__crumbs label" aria-label="Breadcrumb">
        <a href="/#work" class="link">Work</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{String(n + 1).padStart(2, '0')} of {projects.length}</span>
      </nav>
      <h1 class="mega p-hero__title" transition:name={`title-${p.slug}`}>{p.title}</h1>
      <p class="lead p-hero__sub" data-reveal>{p.subtitle}</p>
      <dl class="p-meta" data-reveal style="--i:1">
        {meta.map(([k, v]) => (<div><dt class="label">{k}</dt><dd>{v}</dd></div>))}
      </dl>
    </header>

    <div class="p-cover">
      <Img id={p.hero.id} alt={p.hero.alt} eager reveal={false} sizes="100vw" class="p-cover__img" />
    </div>

    <section class="p-intro wrap grid" aria-label="Overview">
      <p class="label p-intro__label">Overview</p>
      <div class="p-intro__body">
        {p.intro.map((t, k) => <p class:list={[k === 0 ? 'lead' : 'prose']} data-reveal style={`--i:${k}`}>{t}</p>)}
        <ul class="p-intro__links">
          {p.behance.map((href, k) => (
            <li><a class="label link" href={href} target="_blank" rel="noopener">View on Behance{p.behance.length > 1 ? ` (${k + 1})` : ''} <span class="arrow" aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <Blocks blocks={p.blocks} />

    <nav class="p-next" aria-label="More projects">
      <a href={`/work/${next.slug}/`} class="p-next__link wrap" style={`--next-accent:${next.accent}`}>
        <span class="label">Next project</span>
        <span class="p-next__row">
          <span class="display p-next__title">{next.title}</span>
          <span class="p-next__thumb"><Img id={next.cover.id} alt="" sizes="320px" reveal={false} ratio="4 / 5" /></span>
        </span>
        <span class="muted">{next.subtitle}</span>
      </a>
      <div class="wrap p-next__aux">
        <a href={`/work/${prev.slug}/`} class="label link"><span aria-hidden="true">←</span> {prev.title}</a>
        <a href="/#index" class="label link">All projects</a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .p-hero { padding-top: clamp(96px, 14vh, 160px); padding-bottom: var(--s-7); display: grid; gap: var(--s-5); }
  .p-hero__crumbs { display: flex; gap: var(--s-3); align-items: center; }
  .p-hero__crumbs .link { min-height: 0; }
  .p-hero__title { color: var(--ink); overflow-wrap: anywhere; margin-left: -0.04em; }
  .p-hero__sub { max-width: 34ch; }
  .p-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--gutter); margin-top: var(--s-5); padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .p-meta dt { margin-bottom: var(--s-1); }
  .p-meta dd { font-size: var(--t-small); }
  .p-meta div:first-child dd { color: var(--accent); }
  @media (min-width: 900px) {
    .p-hero { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    :where(.p-hero > *) { grid-column: 1 / -1; }
    .p-hero__sub { grid-column: 1 / span 6; }
    .p-meta { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .p-cover { max-height: 92svh; overflow: hidden; }
  .p-cover :global(.p-cover__img) { max-height: 92svh; aspect-ratio: auto !important; }
  .p-cover :global(.p-cover__img img) { max-height: 92svh; object-fit: contain; margin-inline: auto; width: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .p-cover :global(img) { animation: cover-in 1.4s var(--ease-out) both; }
    @keyframes cover-in { from { clip-path: inset(12% 8% 12% 8%); transform: scale(1.06); } to { clip-path: inset(0); transform: none; } }
  }

  .p-intro { padding-block: var(--section) clamp(var(--s-7), 8vw, var(--s-10)); row-gap: var(--s-5); }
  .p-intro__label, .p-intro__body { grid-column: 1 / -1; }
  .p-intro__body { display: grid; gap: var(--s-5); max-width: 820px; }
  .p-intro__links { display: flex; flex-wrap: wrap; gap: var(--s-5); }
  @media (min-width: 900px) {
    .p-intro__label { grid-column: 1 / span 3; padding-top: 0.6em; }
    .p-intro__body { grid-column: 4 / span 8; }
  }

  .p-next { margin-top: var(--section); border-top: 1px solid var(--line); }
  .p-next__link { display: grid; gap: var(--s-4); padding-block: var(--s-8) var(--s-6); }
  .p-next__row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); }
  .p-next__title { transition: color var(--d-base) var(--ease-out), transform var(--d-base) var(--ease-out); }
  .p-next__thumb { width: clamp(88px, 14vw, 220px); flex: none; transition: transform var(--d-slow) var(--ease-out); }
  .p-next__link:hover .p-next__title, .p-next__link:focus-visible .p-next__title { color: var(--next-accent); transform: translateX(var(--s-3)); }
  .p-next__link:hover .p-next__thumb { transform: rotate(-3deg) scale(1.04); }
  .p-next__aux { display: flex; justify-content: space-between; gap: var(--s-4); padding-bottom: var(--s-6); }
</style>
