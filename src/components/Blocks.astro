---
import Img from './Img.astro';
import type { Block } from '../data/projects';

interface Props { blocks: Block[] }
const { blocks } = Astro.props;

// Pick readable ink for a swatch.
const ink = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? '#0e0e0c' : '#edeae3';
};
---
<div class="blocks">
  {blocks.map((b) => {
    switch (b.t) {
      case 'full':
        return (
          <figure class:list={['b-full', b.bleed ? 'is-bleed' : 'wrap']} style={b.tone ? `--tone:${b.tone}` : undefined}>
            <Img id={b.img.id} alt={b.img.alt} sizes={b.bleed ? '100vw' : '(min-width: 1680px) 1570px, 92vw'} />
            {b.caption && <figcaption class:list={['label', b.bleed && 'wrap']}>{b.caption}</figcaption>}
          </figure>
        );
      case 'pair':
        return (
          <figure class:list={['b-pair wrap', b.offset && 'is-offset']}>
            <div class="b-pair__in">
              {b.imgs.map((im, n) => <Img id={im.id} alt={im.alt} i={n} sizes="(min-width: 700px) 46vw, 92vw" />)}
            </div>
            {b.caption && <figcaption class="label">{b.caption}</figcaption>}
          </figure>
        );
      case 'grid':
        return (
          <figure class="b-grid wrap" style={`--cols:${b.cols ?? 3}`}>
            <div class="b-grid__in">
              {b.imgs.map((im, n) => <Img id={im.id} alt={im.alt} i={n} sizes={`(min-width: 900px) ${Math.round(92 / (b.cols ?? 3))}vw, 46vw`} />)}
            </div>
            {b.caption && <figcaption class="label">{b.caption}</figcaption>}
          </figure>
        );
      case 'text':
        return (
          <section class="b-text wrap grid">
            {b.label && <p class="label b-text__label" data-reveal>{b.label}</p>}
            <div class="b-text__body">
              {b.title && <h2 class="h3" data-reveal>{b.title}</h2>}
              <div class="prose" data-reveal style="--i:1">{b.body.map((p) => <p>{p}</p>)}</div>
            </div>
          </section>
        );
      case 'split':
        return (
          <section class:list={['b-split wrap grid', b.side === 'left' && 'is-left']}>
            <div class="b-split__media"><Img id={b.img.id} alt={b.img.alt} sizes="(min-width: 900px) 56vw, 92vw" /></div>
            <div class="b-split__text">
              {b.label && <p class="label" data-reveal>{b.label}</p>}
              {b.title && <h2 class="h3" data-reveal style="--i:1">{b.title}</h2>}
              <div class="prose" data-reveal style="--i:2">{b.body.map((p) => <p>{p}</p>)}</div>
            </div>
          </section>
        );
      case 'chapter':
        return (
          <section class="b-chapter wrap">
            <div class="b-chapter__top">
              <p class="label" data-reveal>{b.index}</p>
              <p class="label b-chapter__meta" data-reveal>{b.meta}</p>
            </div>
            <h2 class="h1" data-reveal style="--i:1">{b.title}</h2>
            {b.body && <p class="lead b-chapter__body" data-reveal style="--i:2">{b.body}</p>}
          </section>
        );
      case 'palette':
        return (
          <section class="b-palette wrap grid">
            <p class="label b-text__label" data-reveal>{b.label}</p>
            <div class="b-text__body"><p class="lead" data-reveal>{b.body}</p></div>
            <ul class="b-palette__list" role="list">
              {b.colors.map((c, n) => (
                <li data-reveal style={`--i:${n};background:${c};color:${ink(c)}`}>
                  <span class="label" style="color:inherit">{c}</span>
                </li>
              ))}
            </ul>
          </section>
        );
      case 'type':
        return (
          <section class="b-type wrap grid">
            <p class="label b-text__label" data-reveal>{b.label}</p>
            <div class="b-text__body"><p class="lead" data-reveal>{b.body}</p></div>
            <div class="b-type__lockup"><Img id={b.lockup.id} alt={b.lockup.alt} fit="contain" sizes="(min-width: 900px) 70vw, 92vw" /></div>
            <ul class="b-type__faces" role="list">
              {b.faces.map((f, n) => (
                <li data-reveal style={`--i:${n}`}>
                  <p class="b-type__name" style={f.specimen ? `font-family:'${f.specimen}', serif` : undefined}>{f.name}</p>
                  <p class="label">{f.role}</p>
                  <p class="muted">{f.body}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      case 'trio':
        return (
          <section class="b-trio wrap grid">
            <p class="label b-text__label" data-reveal>{b.label}</p>
            <h2 class="h2 b-trio__title" data-reveal style="--i:1">{b.title}</h2>
            <ul class="b-trio__items" role="list" style={`--n:${b.items.length}`}>
              {b.items.map((it, n) => (
                <li>
                  <Img id={it.img.id} alt={it.img.alt} i={n} sizes="(min-width: 900px) 44vw, 92vw" ratio={n === 0 ? '1 / 1' : undefined} />
                  <h3 class="h3" data-reveal>{it.title}</h3>
                  <p class="muted" data-reveal style="--i:1">{it.body}</p>
                </li>
              ))}
            </ul>
          </section>
        );
    }
  })}
</div>

<style>
  .blocks { display: flex; flex-direction: column; gap: clamp(var(--s-7), 8vw, var(--s-10)); }
  figure { display: grid; gap: var(--s-3); }
  figcaption { padding-top: var(--s-1); }

  .b-full.is-bleed { padding: 0; }
  .b-full[style*='--tone'] .media { background-color: var(--tone); }

  .b-pair__in { display: grid; gap: var(--gutter); align-items: start; }
  .b-grid__in { display: grid; gap: var(--gutter); grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  @media (min-width: 700px) {
    .b-pair__in { grid-template-columns: 1fr 1fr; }
    .b-pair.is-offset .b-pair__in > :last-child { margin-top: 18%; }
  }
  @media (min-width: 900px) {
    .b-grid__in { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
  }

  .b-text, .b-palette, .b-type, .b-trio { row-gap: var(--s-5); }
  .b-text__label, .b-text__body, .b-trio__title { grid-column: 1 / -1; }
  .b-text__body { display: grid; gap: var(--s-5); max-width: 760px; }
  @media (min-width: 900px) {
    .b-text__label { grid-column: 1 / span 3; padding-top: 0.5em; }
    .b-text__body { grid-column: 4 / span 8; }
    .b-trio__title { grid-column: 4 / -1; }
  }

  .b-split { row-gap: var(--s-5); align-items: center; }
  .b-split__media, .b-split__text { grid-column: 1 / -1; }
  .b-split__text { display: grid; gap: var(--s-4); }
  @media (min-width: 900px) {
    .b-split__media { grid-column: 1 / span 7; }
    .b-split__text { grid-column: 9 / span 4; }
    .b-split.is-left .b-split__media { grid-column: 6 / span 7; grid-row: 1; }
    .b-split.is-left .b-split__text { grid-column: 1 / span 4; grid-row: 1; }
  }

  .b-chapter { display: grid; gap: var(--s-5); padding-top: var(--s-6); border-top: 1px solid var(--accent); margin-top: var(--s-8); }
  .b-chapter__top { display: flex; justify-content: space-between; gap: var(--s-4); }
  .b-chapter__top .label:first-child { color: var(--accent); }
  .b-chapter__body { max-width: 40ch; color: var(--ink-2); }
  @media (min-width: 900px) {
    .b-chapter { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .b-chapter__top { grid-column: 1 / -1; }
    .b-chapter h2 { grid-column: 1 / span 7; }
    .b-chapter__body { grid-column: 9 / span 4; align-self: end; }
  }

  .b-palette__list { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin-top: var(--s-5); }
  .b-palette__list li { aspect-ratio: 3 / 4; display: flex; align-items: flex-end; padding: var(--s-3); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  @media (max-width: 599px) {
    .b-palette__list li { aspect-ratio: 1 / 2.4; }
    .b-palette__list .label { writing-mode: vertical-rl; transform: rotate(180deg); }
  }

  .b-type__lockup { grid-column: 1 / -1; margin-block: var(--s-6); }
  .b-type__lockup :global(.media) { background-color: #0b0c08; }
  .b-type__faces { grid-column: 1 / -1; display: grid; gap: var(--s-7); }
  .b-type__faces li { display: grid; gap: var(--s-2); align-content: start; border-top: 1px solid var(--line); padding-top: var(--s-5); }
  .b-type__name { font-size: clamp(2.2rem, 4vw, 3.6rem); line-height: 1; font-weight: 600; font-variation-settings: 'wdth' 85; margin-bottom: var(--s-2); }
  @media (min-width: 900px) {
    .b-type__lockup { grid-column: 3 / span 8; }
    .b-type__faces { grid-column: 4 / -1; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  }

  .b-trio__items { grid-column: 1 / -1; display: grid; gap: var(--s-8); margin-top: var(--s-7); }
  .b-trio__items li { display: grid; gap: var(--s-3); align-content: start; }
  .b-trio__items .h3 { margin-top: var(--s-3); }
  @media (min-width: 900px) {
    .b-trio__items { grid-template-columns: 5fr 7fr; gap: var(--gutter); align-items: end; }
    .b-trio__items li:first-child { padding-bottom: 12%; }
  }
</style>
