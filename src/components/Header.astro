---
import { ui, url, basePath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const path = basePath(Astro.url.pathname);
const other: Lang = lang === 'he' ? 'en' : 'he';
const nav = [
  { href: url(lang, '/') + '#work', label: ui.nav.work[lang], active: path.startsWith('/work') },
  { href: url(lang, '/about/'), label: ui.nav.about[lang], active: path.startsWith('/about') },
  { href: '#contact', label: ui.nav.contact[lang], active: false },
];
---
<header class="hdr">
  <div class="hdr__in wrap">
    <a href={url(lang, '/')} class="hdr__name">{ui.name[lang]}</a>
    <p class="hdr__status label" aria-hidden="true"><span class="dot"></span>{ui.available[lang]}</p>
    <nav aria-label={lang === 'he' ? 'ראשי' : 'Main'}>
      <ul class="hdr__nav">
        {nav.map((n) => (
          <li><a href={n.href} class="link label" aria-current={n.active ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li>
          <a href={url(other, path.startsWith('/404') ? '/' : path)} class="link label hdr__lang" hreflang={other} lang={other} aria-label={ui.switchLabel[lang]}>
            {ui.switchTo[lang]}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    mix-blend-mode: difference; color: #fff;
    pointer-events: none;
  }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); padding-block: var(--s-2); }
  .hdr a, .hdr p { pointer-events: auto; }
  .hdr__name {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--f-display); font-weight: 800; font-variation-settings: 'wdth' 62; text-transform: uppercase;
    font-size: 1.35rem; letter-spacing: 0.01em; line-height: 1; white-space: nowrap;
  }
  :global([lang='he']) .hdr__name { font-size: 1.6rem; font-weight: 700; }
  .hdr__status { color: inherit; display: none; align-items: center; gap: var(--s-2); margin-inline: var(--s-7) auto; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .hdr__nav { display: flex; gap: clamp(var(--s-3), 2.4vw, var(--s-6)); }
  .hdr__nav .label { color: inherit; white-space: nowrap; }
  .hdr__nav [aria-current='page']::after { transform: scaleX(1); }
  .hdr__lang { padding-inline-start: clamp(var(--s-3), 2.4vw, var(--s-6)); border-inline-start: 1px solid currentColor; }
  .hdr__lang::after { display: none; }
  .hdr__lang:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 900px) { .hdr__status { display: inline-flex; } }
  @media (max-width: 420px) {
    .hdr__in { gap: var(--s-3); }
    .hdr__nav { gap: var(--s-3); }
    .hdr__lang { padding-inline-start: var(--s-3); }
    .hdr__name { font-size: 1.15rem; }
    :global([lang='he']) .hdr__name { font-size: 1.4rem; }
    .hdr__nav .label { font-size: 0.6875rem; letter-spacing: 0.03em; }
  }
</style>
