---
// Home page: one section per category, the same template for all three — the category name set large with its count,
// a line on what it holds, then its covers on a coverflow rack you drive yourself: the centre cover faces you flat,
// the ones beside it swing their outer edges toward you (the same curve as the site's earlier cylinder gallery).
// Adapted from ruixen.ui's "Coverflow Carousel" on 21st.dev (React/Tailwind) into Astro + CSS + a small custom element:
// no loop (a category holds 3–5 projects), right-to-left in Hebrew, and every cover in a category in the same frame
// (the category's `frame`, e.g. square for party branding; `cover.focus` picks what a crop keeps).
// It advances by itself, slowly — one cover every ~4s in a long ease-in-out glide, turning back at either end (so it
// only ever moves one cover at a time) — and the name under the centre cover changes as each new cover reaches it. It holds still while the pointer is over it, while it has keyboard focus, while it is off
// screen or the tab is hidden, and for a while after you move it yourself; the pause button stops it for good.
// Ways to move: drag (mouse / touch), a sideways trackpad swipe, clicking a side cover, the prev / next buttons, and the
// arrow keys; Tab walks the projects and brings each one to the centre. Clicking the centre cover opens the project.
// Without JS the covers sit in a plain sideways-scrolling row; with reduced motion nothing advances by itself and the
// rack jumps instead of gliding.
import Img from './Img.astro';
import { inCategory, type Category } from '../data/projects';
import { ui, url, fwd, back, dir, type Lang } from '../i18n';

interface Props { lang: Lang; c: Category; n?: number } // n: the section's place on the page, to stagger the autoplay
const { lang, c, n = 0 } = Astro.props;
const [fw, fh] = c.frame.split('/').map(Number);
const frame = fw / fh;
const items = inCategory(c.slug);
const start = Math.floor((items.length - 1) / 2); // open on the middle cover, so the rack is full on both sides
const id = `cat-${c.slug}`;
const two = (n: number) => String(n).padStart(2, '0');
---
<section id={c.slug} class="cs wrap" aria-labelledby={id}>
  <div class="cs__head">
    <h2 id={id} class="h2 cs__title" data-reveal>{c.title[lang]}<sup class="cs__n">{items.length}</sup></h2>
    <div class="cs__side" data-reveal style="--i:1">
      <p class="muted cs__intro">{c.intro[lang]}</p>
      <a href={url(lang, `/work/${c.slug}/`)} class="label link">{ui.categoryPage[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a>
    </div>
  </div>

  <cover-flow class="cf" data-start={start} data-delay={n * 1300} data-rtl={dir(lang) === 'rtl' ? '' : undefined} style={`--frame:${frame.toFixed(4)};--k:${frame > 1 ? 1.25 : 1}`} role="region" aria-roledescription="carousel" aria-label={c.title[lang]}>
    <div class="cf__stage">
      <ul class="cf__track" role="list">
        {items.map((p, k) => (
          <li class="cf__card" style={`--wa:${p.accent}`} data-title={p.title[lang]} data-year={p.year} data-sub={p.subtitle[lang]}>
            <a href={url(lang, `/work/${p.slug}/`)} class="cf__link" draggable="false" aria-label={`${p.title[lang]} — ${p.subtitle[lang]} (${k + 1} ${ui.of[lang]} ${items.length})`}>
              <Img id={p.cover.id} alt="" reveal={false} ratio={c.frame} focus={p.cover.focus} sizes="(min-width: 900px) 34vw, 80vw" class="cf__img" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="cf__bar" aria-hidden="true">
      <p class="cf__cap">
        <span class="cf__name">{items[start].title[lang]}</span>
        <span class="muted cf__sub">{items[start].subtitle[lang]}</span>
      </p>
      <div class="cf__ctrl">
        <button type="button" class="cf__btn" data-step="-1" tabindex="-1" title={ui.carousel.prev[lang]}>{back(lang)}</button>
        <span class="label cf__count"><bdi dir="ltr"><span class="cf__at">{two(start + 1)}</span> / {two(items.length)}</bdi></span>
        <button type="button" class="cf__btn" data-step="1" tabindex="-1" title={ui.carousel.next[lang]}>{fwd(lang)}</button>
        <button type="button" class="cf__btn cf__play" tabindex="-1" title={ui.carousel.pause[lang]} data-pause={ui.carousel.pause[lang]} data-play={ui.carousel.play[lang]}>
          <svg class="cf__i-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor" /></svg>
          <svg class="cf__i-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor" /></svg>
        </button>
      </div>
    </div>
  </cover-flow>
</section>

<script>
  // Tuning, as in the original: tilt of the first neighbour (deg), how far it recedes (× card width), how fast both
  // ease off with distance, opacity lost per step, gap between cards (× card width).
  const ROTATE = 44, DEPTH = 0.6, FALLOFF = 0.56, FADE = 0.12, GAP = 0.05;
  const EVERY = 4200; // ms per cover when it moves by itself (glide included)
  const GLIDE = 1500; // ms for one cover's glide; a few more ms for each further cover
  const THROW = 650; // ms to settle after a drag or a swipe
  const inOut = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2; // ease-in-out sine: starts and lands softly
  const out = (t: number) => 1 - Math.pow(1 - t, 3); // ease-out cubic: keeps the speed of your hand, then lands
  const IDLE = 6000; // after you move it yourself, it waits this long before carrying on
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  class CoverFlow extends HTMLElement {
    cards: HTMLElement[] = [];
    pos = 0; // fractional index at the centre — the single source of truth
    target = 0;
    width = 0;
    sign = 1; // +1: the next cover sits to the right; -1 in Hebrew
    raf = 0;
    wheelTimer = 0;
    drag: { id: number; x: number; pos: number; v: number; t: number; moved: boolean } | null = null;
    ro?: ResizeObserver;
    io?: IntersectionObserver;
    timer = 0; // the next autoplay step
    startTimer = 0;
    userTimer = 0;
    hold = new Set<string>(); // reasons to stand still right now: hover, focus, drag, offscreen, hidden, user
    stopped = false; // the pause button
    dir = 1; // which way autoplay is heading; it turns back at either end
    shown = -1; // the cover whose name is under the rack

    connectedCallback() {
      this.cards = [...this.querySelectorAll<HTMLElement>('.cf__card')];
      this.sign = this.hasAttribute('data-rtl') ? -1 : 1;
      this.pos = this.target = Number(this.dataset.start) || 0;
      this.classList.add('is-on');
      const stage = this.querySelector<HTMLElement>('.cf__stage')!;

      // card width drives pitch and depth: measure now, then again whenever the stage changes size
      const measure = () => { this.width = this.cards[0].offsetWidth; this.paint(); };
      this.ro = new ResizeObserver(measure);
      this.ro.observe(stage);
      measure();

      stage.addEventListener('pointerdown', this.down);
      stage.addEventListener('pointermove', this.move);
      stage.addEventListener('pointerup', this.up);
      stage.addEventListener('pointercancel', this.up);
      stage.addEventListener('wheel', this.wheel, { passive: false });
      stage.addEventListener('click', this.click, true);
      this.addEventListener('keydown', this.key);
      this.addEventListener('focusin', this.focus);
      this.querySelectorAll<HTMLButtonElement>('.cf__btn[data-step]').forEach((b) => b.addEventListener('click', () => { this.touched(); this.nudge(Number(b.dataset.step)); }));
      this.querySelector('.cf__play')!.addEventListener('click', () => this.toggle());
      this.caption(this.pos, false);
      this.buttons();

      // autoplay: never with reduced motion; it stands still whenever any reason in `hold` applies
      if (still.matches) this.toggle(true);
      this.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') this.pause('hover'); });
      this.addEventListener('pointerleave', () => this.resume('hover'));
      // keyboard focus only: a mouse click also focuses the link, and that should not stop it for good
      this.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches(':focus-visible')) this.pause('focus'); });
      this.addEventListener('focusout', (e) => { if (!this.contains(e.relatedTarget as Node)) this.resume('focus'); });
      this.pause('offscreen'); // until the observer says it is in view
      this.io = new IntersectionObserver(([e]) => (e.isIntersecting ? this.resume('offscreen') : this.pause('offscreen')), { threshold: 0.4 });
      this.io.observe(this);
      document.addEventListener('visibilitychange', this.visible);
      // the three racks start a little apart, so they never step in unison
      this.pause('start');
      this.startTimer = window.setTimeout(() => this.resume('start'), Number(this.dataset.delay) || 0);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.raf);
      clearTimeout(this.wheelTimer);
      clearTimeout(this.timer);
      clearTimeout(this.startTimer);
      clearTimeout(this.userTimer);
      this.ro?.disconnect();
      this.io?.disconnect();
      document.removeEventListener('visibilitychange', this.visible);
    }

    // ---- autoplay ----
    schedule() {
      clearTimeout(this.timer);
      if (this.stopped || this.hold.size) return;
      this.timer = window.setTimeout(() => {
        const at = Math.round(this.target);
        if (at + this.dir > this.cards.length - 1 || at + this.dir < 0) this.dir *= -1;
        this.settle(at + this.dir);
        this.schedule();
      }, EVERY);
    }
    pause(why: string) { this.hold.add(why); clearTimeout(this.timer); }
    resume(why: string) { this.hold.delete(why); this.schedule(); }
    // you moved it: hold for a while, then carry on from where you left it
    touched() {
      this.pause('user');
      clearTimeout(this.userTimer); // the wait restarts with every move
      this.userTimer = window.setTimeout(() => this.resume('user'), IDLE);
    }
    toggle(off = !this.stopped) {
      this.stopped = off;
      const b = this.querySelector<HTMLButtonElement>('.cf__play')!;
      b.classList.toggle('is-stopped', off);
      b.title = (off ? b.dataset.play : b.dataset.pause)!;
      this.schedule();
    }
    visible = () => (document.hidden ? this.pause('hidden') : this.resume('hidden'));

    clamp = (p: number) => Math.max(0, Math.min(this.cards.length - 1, p));
    get pitch() { return this.width * (1 + GAP); }

    // Straight to the DOM, transform and opacity only.
    paint() {
      if (!this.width) return;
      this.cards.forEach((card, i) => {
        const offset = i - this.pos;
        const screen = offset * this.sign; // where it sits on screen: right is positive
        const d = Math.abs(offset);
        const ramp = Math.pow(d, FALLOFF);
        const tilt = Math.min(ROTATE * ramp, 82) * Math.sign(screen);
        card.style.transform = `translateX(calc(-50% + ${screen * this.pitch}px)) translateZ(${-DEPTH * this.width * ramp}px) rotateY(${-tilt}deg)`;
        card.style.opacity = String(Math.max(0.25, 1 - FADE * d));
        card.style.zIndex = String(100 - Math.round(d * 10));
        card.classList.toggle('is-active', Math.round(this.pos) === i);
      });
      const at = Math.round(this.pos);
      if (at !== this.shown) this.caption(at, this.shown >= 0);
    }

    // the name under the rack: whichever cover is at the centre right now (it changes mid-glide, as the cover arrives)
    caption(i: number, fade = true) {
      this.shown = i;
      const card = this.cards[i];
      if (fade) {
        const cap = this.querySelector<HTMLElement>('.cf__cap')!;
        cap.classList.remove('is-new');
        void cap.offsetWidth;
        cap.classList.add('is-new');
      }
      this.querySelector('.cf__name')!.textContent = card.dataset.title!;
      this.querySelector('.cf__sub')!.textContent = card.dataset.sub!;
      this.querySelector('.cf__at')!.textContent = String(i + 1).padStart(2, '0');
      this.style.setProperty('--wa', card.style.getPropertyValue('--wa'));
    }

    // the prev / next buttons follow where the rack is heading
    buttons() {
      const i = Math.round(this.target);
      const [prev, next] = this.querySelectorAll<HTMLButtonElement>('.cf__btn[data-step]');
      prev.disabled = i === 0;
      next.disabled = i === this.cards.length - 1;
    }

    // Glide to a cover over a fixed time: a soft ease-in-out for steps (autoplay, buttons, keys, clicks), a quicker
    // ease-out after a drag or swipe so the rack carries on from your hand instead of starting over.
    settle(to: number, thrown = false) {
      cancelAnimationFrame(this.raf);
      this.target = this.clamp(Math.round(to));
      this.buttons();
      const from = this.pos;
      const span = this.target - from;
      if (still.matches || Math.abs(span) < 0.0004) { this.pos = this.target; this.paint(); return; }
      const ms = thrown ? THROW : GLIDE + 350 * (Math.abs(span) - 1);
      const ease = thrown ? out : inOut;
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / ms);
        this.pos = from + span * ease(t);
        this.paint();
        if (t < 1) this.raf = requestAnimationFrame(step);
      };
      this.raf = requestAnimationFrame(step);
    }

    nudge(by: number) { this.settle(this.target + by); }

    down = (e: PointerEvent) => {
      if (e.button !== 0) return;
      cancelAnimationFrame(this.raf);
      this.pause('drag');
      this.drag = { id: e.pointerId, x: e.clientX, pos: this.pos, v: 0, t: performance.now(), moved: false };
    };

    move = (e: PointerEvent) => {
      const d = this.drag;
      if (!d || d.id !== e.pointerId || !this.pitch) return;
      const dx = e.clientX - d.x;
      if (!d.moved) {
        if (Math.abs(dx) < 6) return;
        // only now take the pointer — a plain click must still reach the link underneath
        d.moved = true;
        (e.currentTarget as HTMLElement).setPointerCapture(e.pointerId);
        this.classList.add('is-dragging');
      }
      const now = performance.now();
      const before = this.pos;
      this.pos = this.clamp(d.pos - (dx / this.pitch) * this.sign);
      d.v = ((this.pos - before) / Math.max(now - d.t, 1)) * 1000; // covers per second, for the throw
      d.t = now;
      this.paint();
    };

    up = (e: PointerEvent) => {
      const d = this.drag;
      if (!d || d.id !== e.pointerId) return;
      this.classList.remove('is-dragging');
      if (d.moved) this.touched();
      this.resume('drag');
      if (d.moved) {
        this.settle(this.pos + Math.max(-2, Math.min(2, d.v * 0.18)), true); // a flick carries, two covers at most
        setTimeout(() => { this.drag = null; }); // still set while the click that follows a drag fires
      } else this.drag = null;
    };

    // After a drag, swallow the click. A side cover comes to the centre instead of opening.
    click = (e: MouseEvent) => {
      if (this.drag?.moved) { e.preventDefault(); e.stopPropagation(); return; }
      const card = (e.target as HTMLElement).closest<HTMLElement>('.cf__card');
      if (!card) return;
      const i = this.cards.indexOf(card);
      if (i !== Math.round(this.target)) { e.preventDefault(); this.touched(); this.settle(i); }
    };

    // Sideways trackpad swipes (and shift + wheel) move the rack; a plain vertical wheel keeps scrolling the page.
    wheel = (e: WheelEvent) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY) || !this.pitch) return;
      e.preventDefault();
      cancelAnimationFrame(this.raf);
      this.touched();
      this.pos = this.clamp(this.pos + (e.deltaX / this.pitch) * this.sign);
      this.paint();
      clearTimeout(this.wheelTimer);
      this.wheelTimer = window.setTimeout(() => this.settle(this.pos, true), 120);
    };

    key = (e: KeyboardEvent) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      this.touched();
      const right = e.key === 'ArrowRight' ? 1 : -1;
      this.nudge(right * this.sign);
      this.cards[Math.round(this.target)].querySelector('a')!.focus({ preventScroll: true });
    };

    // Keyboard focus brings the cover to the centre (a mouse press is handled by `click`).
    focus = (e: FocusEvent) => {
      const link = e.target as HTMLElement;
      if (!link.matches(':focus-visible')) return;
      const i = this.cards.findIndex((c) => c.contains(link));
      if (i >= 0 && i !== Math.round(this.target)) this.settle(i);
    };
  }

  if (!customElements.get('cover-flow')) customElements.define('cover-flow', CoverFlow);
</script>

<style>
  .cs { padding-top: var(--s-10); }
  .cs:first-child { padding-top: var(--section); }

  .cs__head { display: grid; gap: var(--s-4); padding-bottom: var(--s-5); }
  .cs__title { display: flex; align-items: flex-start; }
  .cs__n { font-family: var(--f-mono); font-size: 0.875rem; font-weight: 400; letter-spacing: 0; margin-inline-start: 0.4em; color: var(--ink-3); }
  .cs__side { display: grid; gap: var(--s-3); justify-items: start; }
  .cs__intro { max-width: 46ch; }

  /* --frame: the category's aspect ratio; --k widens landscape frames so every rack reads about the same size */
  .cf { display: block; --card: calc(min(62vw, 290px) * var(--k, 1)); }

  /* no JS: a plain sideways-scrolling row */
  .cf__stage { margin-inline: calc(-1 * var(--margin)); overflow-x: auto; scrollbar-width: none; }
  .cf__stage::-webkit-scrollbar { display: none; }
  .cf__track { display: flex; gap: var(--s-4); padding-inline: var(--margin); }
  .cf__card { flex: 0 0 auto; width: var(--card); }
  .cf__bar { display: none; }

  .cf__link { display: block; }
  .cf__link :global(img) { -webkit-user-drag: none; user-select: none; }

  /* the rack */
  .cf.is-on .cf__stage {
    overflow: hidden;
    perspective: calc(var(--card) * 3);
    padding-block: var(--s-6);
    cursor: grab;
    touch-action: pan-y; /* sideways drags are ours; the page keeps its vertical scroll */
    user-select: none;
  }
  .cf.is-dragging .cf__stage { cursor: grabbing; }
  /* the side covers sit behind the track's plane (negative Z), so the track must not catch their clicks */
  .cf.is-on .cf__track { position: relative; height: calc(var(--card) / var(--frame, 1)); padding: 0; transform-style: preserve-3d; pointer-events: none; }
  .cf.is-on .cf__card { position: absolute; top: 0; left: 50%; will-change: transform; pointer-events: auto; }
  .cf.is-on .cf__link { transition: box-shadow var(--d-base) var(--ease-out); }
  .cf.is-on .cf__card.is-active .cf__link { cursor: pointer; }
  .cf.is-on .cf__card.is-active .cf__link:hover { box-shadow: 0 0 0 1px var(--wa); }
  .cf.is-dragging .cf__link { pointer-events: none; }
  .cf__link:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }

  /* caption and controls under the rack: what is in the centre, where you are, and the way to move */
  /* the name sits right under the centre cover, as wide as it; the controls sit quietly beneath */
  .cf.is-on .cf__bar { display: grid; justify-items: center; gap: var(--s-4); margin-top: calc(-1 * var(--s-3)); text-align: center; }
  .cf__cap { display: grid; gap: var(--s-1); width: min(100%, calc(var(--card) * 1.15)); min-height: 4.6em; align-content: start; }
  .cf__name { font-weight: 600; font-size: var(--t-lead); line-height: 1.2; color: var(--wa, var(--ink)); transition: color var(--d-base) var(--ease-out); }
  .cf__sub { font-size: var(--t-small); }
  @media (prefers-reduced-motion: no-preference) {
    /* a soft cross-fade as each new cover reaches the centre */
    .cf__cap.is-new > * { animation: cf-name 0.9s var(--ease-in-out) both; }
    .cf__cap.is-new > .cf__sub { animation-delay: 80ms; }
    @keyframes cf-name { from { opacity: 0; } to { opacity: 1; } }
  }
  .cf__ctrl { display: flex; align-items: center; gap: var(--s-2); flex-shrink: 0; }
  .cf__count { color: var(--ink-3); margin-inline: var(--s-2); }
  .cf__btn {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 50%;
    background: none; color: var(--ink); font: inherit; font-size: 1.1rem;
    cursor: pointer;
    transition: border-color var(--d-fast) var(--ease-out), opacity var(--d-fast) var(--ease-out);
  }
  .cf__btn:hover:not(:disabled) { border-color: var(--ink); }
  .cf__btn:disabled { opacity: 0.3; cursor: default; }
  .cf__play { margin-inline-start: var(--s-2); }
  .cf__i-play, .cf__play.is-stopped .cf__i-pause { display: none; }
  .cf__play.is-stopped .cf__i-play { display: block; }

  @media (min-width: 900px) {
    .cs__head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; padding-bottom: var(--s-6); }
    .cs__title { grid-column: 1 / span 7; }
    .cs__side { grid-column: 8 / -1; }
    .cf { --card: calc(clamp(250px, 24vw, 400px) * var(--k, 1)); }
  }
</style>
