---
// Ambient "aura" behind the Hero portrait: a few large, soft colour fields that drift and breathe very slowly,
// like stage light behind an artist on a party poster. Colours are sampled from the two artworks (face patterns of
// 02_GOTHIC / 03_SURREALISM). When the portrait reveals an artwork (`portrait:reveal`), the aura shifts to that
// artwork's palette, and settles back when the window closes (`portrait:conceal`).
// Decorative only (aria-hidden). Transform/opacity animation, paused while the Hero is off screen; static with reduced motion.
// Place it inside the same parent as <PortraitReveal>; position/size it from the parent (it is absolutely positioned).
type Blob = { x: number; y: number; s: number; c: string };
const sets: Record<string, Blob[]> = {
  // resting state: a quiet mix of both palettes
  // (x, y = centre in % of the aura box; s = diameter in % of its width) — weighted to where the cut-out leaves
  // background showing: around the head and beside the shoulder
  // Keep every field (plus its drift, up to ~15% of its size) inside the box: the box's fade mask clips anything past its edge.
  base: [
    { x: 44, y: 34, s: 56, c: '#613070' },
    { x: 36, y: 64, s: 42, c: '#286d7f' },
    { x: 80, y: 28, s: 34, c: '#835338' },
  ],
  gothic: [
    { x: 44, y: 32, s: 60, c: '#783663' },
    { x: 36, y: 62, s: 46, c: '#863c4d' },
    { x: 80, y: 28, s: 36, c: '#c69254' },
  ],
  surrealism: [
    { x: 44, y: 32, s: 60, c: '#286d7f' },
    { x: 36, y: 62, s: 46, c: '#2d4570' },
    { x: 80, y: 28, s: 36, c: '#d9a561' },
  ],
};
interface Props { class?: string }
const { class: className } = Astro.props;
---
<hero-aura class:list={['aura', className]} aria-hidden="true">
  {Object.entries(sets).map(([name, blobs]) => (
    <div class="aura__set" data-set={name}>
      {blobs.map((b) => <i style={`--x:${b.x}%;--y:${b.y}%;--s:${b.s}%;--c:${b.c}`} />)}
    </div>
  ))}
</hero-aura>

<style>
  .aura {
    display: block;
    pointer-events: none;
    /* fades out towards the top (keeps the fixed header over plain background) and the bottom (into the next section) */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 24%, #000 68%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 24%, #000 68%, transparent 100%);
  }
  .aura__set { position: absolute; inset: 0; }
  .aura__set[data-set='base'] { opacity: 0.7; }
  .aura__set:not([data-set='base']) { opacity: 0; visibility: hidden; }
  .aura i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    aspect-ratio: 1;
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2); /* centre on (x, y); % margins follow the width */
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c), transparent);
    will-change: transform;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const BASE = 0.7; // resting intensity
  const LIT = 1; // intensity while an artwork is revealed

  class HeroAura extends HTMLElement {
    private mm?: ReturnType<typeof gsap.matchMedia>;

    connectedCallback() {
      const portrait = this.parentElement?.querySelector('portrait-reveal');
      const set = (name: string) => this.querySelector<HTMLElement>(`[data-set="${name}"]`)!;
      const base = set('base');

      this.mm = gsap.matchMedia();
      this.mm.add({ motion: '(prefers-reduced-motion: no-preference)', reduce: '(prefers-reduced-motion: reduce)' }, (ctx) => {
        const reduce = !!ctx.conditions?.reduce;
        const fade = reduce ? 0.3 : 1.4;

        // Slow drift + breathing: each field wanders a little and swells, never in step with the others.
        const r = gsap.utils.random;
        const drift = reduce
          ? []
          : [...this.querySelectorAll('i')].map((el) => {
              const duration = r(9, 16);
              const t = gsap.to(el, {
                xPercent: r(-14, 14),
                yPercent: r(-10, 10),
                scale: r(0.85, 1.18),
                duration,
                ease: 'sine.inOut',
                repeat: -1,
                yoyo: true,
              });
              return t.time(r(0, duration)); // start each field mid-way, so they never move in step
            });
        // Nothing moves while the Hero is scrolled out of view.
        const io = new IntersectionObserver(([en]) => drift.forEach((t) => (en.isIntersecting ? t.resume() : t.pause())));
        io.observe(this);

        // The aura takes on the colours of whatever artwork the portrait is showing.
        let lit: HTMLElement | null = null;
        const onReveal = (e: Event) => {
          const next = set((e as CustomEvent<string>).detail);
          if (lit && lit !== next) gsap.to(lit, { autoAlpha: 0, duration: fade, overwrite: 'auto' });
          lit = next;
          gsap.to(next, { autoAlpha: LIT, duration: fade, ease: 'power2.out', overwrite: 'auto' });
          gsap.to(base, { autoAlpha: BASE * 0.4, duration: fade, overwrite: 'auto' });
        };
        const onConceal = () => {
          if (lit) gsap.to(lit, { autoAlpha: 0, duration: fade * 1.2, ease: 'power2.inOut', overwrite: 'auto' });
          lit = null;
          gsap.to(base, { autoAlpha: BASE, duration: fade * 1.2, overwrite: 'auto' });
        };
        portrait?.addEventListener('portrait:reveal', onReveal);
        portrait?.addEventListener('portrait:conceal', onConceal);

        return () => {
          io.disconnect();
          portrait?.removeEventListener('portrait:reveal', onReveal);
          portrait?.removeEventListener('portrait:conceal', onConceal);
        };
      });
    }

    disconnectedCallback() {
      this.mm?.revert();
      this.mm = undefined;
    }
  }

  if (!customElements.get('hero-aura')) customElements.define('hero-aura', HeroAura);
</script>
