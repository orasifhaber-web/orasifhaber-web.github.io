---
// Home page work gallery: one row of project covers streaming right to left around the inside of a cylinder. The centre
// faces you flat, the ends curve toward you and fade into the page. Idea adapted from 21st.dev's "Tilted Grid Hero"
// (React/Tailwind) into plain Astro + CSS: a CSS box can't bend, so each tile is cut into SLICES vertical strips, each a
// flat facet turned its own few degrees round the cylinder's axis; the tile (preserve-3d) is what moves — one rotateY
// about that same axis carries it along the arc, and only its animation delay sets where it sits. The band is
// transform-only (compositor); the fade is a static mask. JS only sizes the loop (ResizeObserver) and hands a tile its
// next project each time it wraps, out of sight.
// Unlike the original (decorative), every tile is a link: hovering pauses the row and shows that project's title.
// Keyboard, screen readers and search engines get a plain list of links (visible when focused).
import { projects } from '../data/projects';
import { image } from '../lib/img';
import { ui, url, fwd, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const items = projects.map((p) => {
  const img = image(p.cover.id);
  const big = img.widths.find((w) => w >= 1100) ?? img.widths[img.widths.length - 1];
  return {
    href: url(lang, `/work/${p.slug}/`),
    small: `/img/${p.cover.id}-${img.widths[0]}.webp`,
    big: `/img/${p.cover.id}-${big}.webp`,
    title: p.title[lang],
    sub: p.subtitle[lang],
    accent: p.accent,
  };
});
---
<section id="work" class="reel" aria-labelledby="work-title">
  <div class="wrap reel__head">
    <h2 id="work-title" class="label">{ui.work[lang]}</h2>
    <p class="label">{projects.length} {ui.projects[lang]}</p>
  </div>

  <work-reel class="reel__stage" data-items={JSON.stringify(items)} data-arrow={fwd(lang)}>
    <div class="reel__band" aria-hidden="true"></div>
    <p class="reel__caption" aria-hidden="true">
      <span class="reel__title"></span>
      <span class="reel__sub"></span>
    </p>
    <div class="reel__more">
      <a href={url(lang, '/work/')} class="reel__all">
        {ui.allProjects[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span>
      </a>
    </div>
  </work-reel>

  <!-- the same projects as plain links: keyboard, screen readers, search engines; shown when a link is focused -->
  <ol class="reel__index wrap" role="list">
    {projects.map((p) => (
      <li><a href={url(lang, `/work/${p.slug}/`)} class="link">{p.title[lang]} — {p.subtitle[lang]}</a></li>
    ))}
  </ol>
</section>

<style>
  .reel { padding-top: var(--s-9); }
  .reel__head { display: flex; justify-content: space-between; padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }
  .reel__head h2 { color: var(--ink); }

  .reel__stage {
    position: relative;
    display: block;
    height: clamp(400px, 62svh, 560px); /* phones: a band, not a full screen */
    overflow: hidden;
    container-type: size; /* cqw / cqh below are this stage's width / height */
    --more-bottom: clamp(var(--s-4), 3svh, var(--s-6));
  }
  @media (min-width: 900px) { .reel__stage { height: clamp(440px, 82svh, 860px); } }
  .reel__band { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .reel__band.is-ready { opacity: 1; }
  .reel__stage.is-paused :global(.reel__tile) { animation-play-state: paused; }

  .reel__band :global(.reel__tile) { position: absolute; display: block; transform-style: preserve-3d; cursor: pointer; }
  .reel__band :global(.reel__strip) { position: absolute; top: 0; overflow: hidden; background: var(--bg-2); }
  .reel__band :global(.reel__strip img) { position: absolute; top: 0; max-width: none; object-fit: cover; user-select: none; }
  .reel__band :global(.reel__strip:first-child) { border-radius: 6px 0 0 6px; }
  .reel__band :global(.reel__strip:last-child) { border-radius: 0 6px 6px 0; }
  .reel__band :global(.reel__tile) { transition: filter var(--d-base) var(--ease-out); }
  .reel__stage.is-paused :global(.reel__tile:not(.is-on)) { filter: brightness(0.45) saturate(0.6); }

  /* hovered project's title, under the row's centre */
  .reel__caption {
    position: absolute;
    inset-inline: var(--margin);
    bottom: calc(var(--more-bottom) + 48px + var(--s-5)); /* above the "all projects" button */
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--d-base) var(--ease-out), transform var(--d-base) var(--ease-out);
  }
  .reel__stage.is-paused .reel__caption { opacity: 1; transform: none; }
  .reel__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-variation-settings: 'wdth' 62;
    text-transform: uppercase;
    font-size: var(--t-h2);
    line-height: 0.9;
    color: var(--reel-accent, var(--ink));
  }
  .reel__sub { color: var(--ink-2); max-width: 46ch; font-size: var(--t-small); }

  /* the way to the full list of projects */
  /* sits at the foot of the stage, under the row; the hovered project's title appears just above it */
  .reel__more { position: absolute; inset-inline: 0; bottom: var(--more-bottom); z-index: 2; display: flex; justify-content: center; }
  .reel__all {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 48px;
    padding: var(--s-3) var(--s-6);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    transition: border-color var(--d-base) var(--ease-out), background-color var(--d-base) var(--ease-out);
  }
  :global([lang='he']) .reel__all { font-size: 0.8125rem; letter-spacing: 0.02em; }
  .reel__all:hover, .reel__all:focus-visible { border-color: var(--ink-2); background: var(--bg-2); }

  /* accessible index: visually hidden until one of its links gets keyboard focus */
  .reel__index { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .reel__index:focus-within { position: static; width: auto; height: auto; clip-path: none; white-space: normal; display: grid; gap: var(--s-2); padding-block: var(--s-5); }
</style>

<script>
  // Strips per tile: a few degrees of arc each — too few to read as facets.
  const SLICES = 16;
  // Camera distance as a multiple of the cylinder's radius: just past the axis, so the ends swell toward the lens.
  const CAMERA = 1.6;
  // A tile is never wider than this share of the stage, so a phone still shows its neighbours.
  const MAX_WIDTH = 55;
  // Look of the row
  const SPEED = 4.5; // seconds for the row to advance by one tile
  const TILE = 40; // tile height, % of the stage height
  const ASPECT = 1; // covers mix square, portrait and landscape — square crops all of them least
  const GAP = 8; // % of a tile's height
  const AXIS = 42; // vertical centre of the row, % of the stage height (room for the title below)
  // degrees the row has bent round by the frame's edge (5–85); on narrow screens a tight curve brings the ends so close
  // to the camera that they swell far past the screen, so phones get a gentler one
  const curveFor = (width: number) => (width < 700 ? 40 : 72);
  const FADE = 9; // % of the width faded at each end

  // Cylinder radius (share of the stage width) that puts the frame's edge `bend` radians round the arc, seen through
  // the camera: r·sinθ · CAMERA / (CAMERA − 1 + cosθ) = width / 2, solved for r.
  const arc = (bend: number) => (CAMERA - 1 + Math.cos(bend)) / (2 * CAMERA * Math.sin(bend));

  // Lays the loop on the cylinder: `unit` = degrees one tile-height spans, `limit` = how far round a tile's centre can
  // go before it is wholly off-screen, `sweep` = where the loop's ends sit (past `limit`, so tiles only wrap unseen).
  function measure(width: number, height: number, bend: number) {
    const h = Math.min((TILE / 100) * height, ((MAX_WIDTH / 100) * width) / ASPECT);
    const radius = width * arc(bend);
    if (!(h > 0) || !(radius > 0)) return null;
    const deg = (rad: number) => (rad * 180) / Math.PI;
    const unit = deg(h / radius);
    const pitch = (ASPECT + GAP / 100) * unit;
    const limit = deg(bend) + (ASPECT * unit) / 2;
    const columns = Math.min(60, Math.max(2, Math.ceil((2 * limit) / pitch)));
    const round = (n: number) => +n.toFixed(4);
    const sweep = round((columns * pitch) / 2);
    return { columns, sweep, unit: round(unit), limit: round(Math.min(sweep, limit)) };
  }

  type Item = { href: string; small: string; big: string; title: string; sub: string; accent: string };
  let uid = 0;

  class WorkReel extends HTMLElement {
    private ro?: ResizeObserver;
    private key = '';

    connectedCallback() {
      const items: Item[] = JSON.parse(this.dataset.items || '[]');
      if (!items.length) return;
      const band = this.querySelector<HTMLElement>('.reel__band')!;
      const titleEl = this.querySelector<HTMLElement>('.reel__title')!;
      const subEl = this.querySelector<HTMLElement>('.reel__sub')!;
      const id = `reel${++uid}`;
      const orbit = `${id}-orbit`;
      const hiDpi = window.devicePixelRatio > 1.4;
      const srcOf = (it: Item) => (hiDpi ? it.big : it.small);
      // fetch every cover up front: a tile picks up its next one just before it comes back into view
      items.forEach((it) => (new Image().src = srcOf(it)));

      const style = document.createElement('style');
      this.prepend(style);

      const build = (width: number, height: number) => {
        const bend = (Math.min(85, Math.max(5, curveFor(width))) * Math.PI) / 180;
        const L = measure(width, height, bend);
        if (!L) return;
        const key = `${L.columns}|${L.sweep}|${L.unit}|${bend}`;
        if (key === this.key) return;
        this.key = key;
        const { columns, sweep, unit, limit } = L;

        // every length is a multiple of the tile's height (stage height, capped by MAX_WIDTH on narrow screens)
        const u = (n: number) => `calc(${+n.toFixed(4)} * min(${TILE}cqh, ${+(MAX_WIDTH / ASPECT).toFixed(4)}cqw))`;
        const r = 100 * arc(bend);
        const radius = `${+r.toFixed(3)}cqw`;
        // out to the axis, round it, back in: a box sits on the cylinder at the angle rotateY gives it
        const turn = (d: number) => `translateZ(${radius}) rotateY(${+d.toFixed(4)}deg) translateZ(-${radius})`;
        // beyond `limit` a tile is off-screen, so it is hidden there (and where it wraps)
        const hide = +(((sweep - limit) / (2 * sweep || 1)) * 100).toFixed(4);
        const duration = columns * SPEED;
        style.textContent =
          `@keyframes ${orbit}{from{transform:${turn(-sweep)}}to{transform:${turn(sweep)}}` +
          `0%,${hide}%,${100 - hide}%,100%{visibility:hidden}` +
          `${hide + 0.001}%,${100 - hide - 0.001}%{visibility:visible}}` +
          // pausing (not removing) the motion keeps the row whole: every tile is placed by its negative delay
          `@media(prefers-reduced-motion:reduce){#${id} .reel__tile{animation-play-state:paused}}`;

        const mask = `linear-gradient(90deg,transparent,#000 ${FADE}%,#000 ${100 - FADE}%,transparent)`;
        Object.assign(band.style, {
          perspective: `${+(r * CAMERA).toFixed(3)}cqw`,
          perspectiveOrigin: `50% ${AXIS}%`,
          maskImage: mask,
          webkitMaskImage: mask,
        });
        band.id = id;
        band.replaceChildren();

        const share = ASPECT / SLICES;
        for (let t = 0; t < columns; t++) {
          // tile `columns - 1` starts nearest the exit, tile 0 furthest back: numbers tiles in the order they come on
          const first = columns - 1 - t;
          const tile = document.createElement('a');
          tile.className = 'reel__tile';
          tile.tabIndex = -1; // keyboard users get the index list
          Object.assign(tile.style, {
            left: `calc(50% - ${u(ASPECT / 2)})`,
            top: `calc(${AXIS}% - ${u(0.5)})`,
            width: u(ASPECT),
            height: u(1),
            // set as separate properties: the `animation` shorthand would also pin play-state to running inline,
            // overriding the CSS that pauses the row on hover and with reduced motion
            animationName: orbit,
            animationDuration: `${duration}s`,
            animationTimingFunction: 'linear',
            animationDelay: `${-t * SPEED}s`,
            animationIterationCount: 'infinite',
          });
          const imgs: HTMLImageElement[] = [];
          for (let k = 0; k < SLICES; k++) {
            const strip = document.createElement('div');
            strip.className = 'reel__strip';
            Object.assign(strip.style, {
              left: u((ASPECT - share) / 2), // every strip starts at the tile's centre…
              width: k === SLICES - 1 ? u(share) : `calc(${u(share)} + 1px)`, // …a pixel wide of its share: no hairlines
              height: u(1),
              transform: turn((ASPECT / 2 - (k + 0.5) * share) * unit), // …and turns to its own place on the arc
            });
            const img = document.createElement('img');
            img.alt = '';
            img.draggable = false;
            img.decoding = 'async';
            Object.assign(img.style, { left: u(-k * share), width: u(ASPECT), height: u(1) });
            strip.append(img);
            tile.append(strip);
            imgs.push(img);
          }
          const show = (n: number) => {
            const it = items[((n % items.length) + items.length) % items.length];
            tile.href = it.href;
            tile.dataset.n = String(items.indexOf(it));
            const s = srcOf(it);
            imgs.forEach((im) => { if (im.getAttribute('src') !== s) im.src = s; });
          };
          show(first);
          // a tile takes its next project each time it wraps — always off-screen, so nothing swaps in view
          tile.addEventListener('animationiteration', (e) => {
            const lap = Math.round(e.elapsedTime / duration); // counts whole loops, missed events included
            show(lap * columns + first);
          });
          band.append(tile);
        }
        band.classList.add('is-ready');
      };

      this.ro = new ResizeObserver(([en]) => build(en.contentRect.width, en.contentRect.height));
      this.ro.observe(this);

      // hover a tile: the row pauses, the others dim, and the project's title shows under it
      let on: HTMLElement | null = null;
      const enter = (tile: HTMLElement) => {
        on?.classList.remove('is-on');
        on = tile;
        tile.classList.add('is-on');
        const it = items[Number(tile.dataset.n)];
        titleEl.textContent = it.title;
        subEl.textContent = it.sub;
        this.style.setProperty('--reel-accent', it.accent);
        this.classList.add('is-paused');
      };
      const leave = () => {
        on?.classList.remove('is-on');
        on = null;
        this.classList.remove('is-paused');
      };
      band.addEventListener('pointerover', (e) => {
        if ((e as PointerEvent).pointerType === 'touch') return; // phones: a tap simply opens the project
        const tile = (e.target as HTMLElement).closest<HTMLElement>('.reel__tile');
        if (!tile) leave(); // in a gap between tiles: let the row move on
        else if (tile !== on) enter(tile);
      });
      band.addEventListener('pointerleave', leave);
    }

    disconnectedCallback() {
      this.ro?.disconnect();
      this.key = '';
    }
  }

  if (!customElements.get('work-reel')) customElements.define('work-reel', WorkReel);
</script>
