---
// A calm grid of covers — the way into a category (and into all the work on /work/). Like a Behance profile: every
// cover in the same Behance frame, with only the project's name and year centred beneath it; client, discipline and tools
// wait inside the project. One column on a phone, two from 700px, three from 1100px.
// Under the pointer (or keyboard focus) the picture darkens and "View project →" appears over it; the name stays where
// it is, beneath, so it is never shown twice.
import Img from './Img.astro';
import { coverFrame, type Project } from '../data/projects';
import { ui, url, fwd, type Lang } from '../i18n';

interface Props { lang: Lang; items: Project[]; level?: 2 | 3 } // level: heading level of the project names
const { lang, items, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---
<ul class="wg wrap" role="list">
  {items.map((p, k) => (
    <li style={`--wa:${p.accent}`}>
      <a href={url(lang, `/work/${p.slug}/`)} class="wg__card">
        <span class="wg__media">
          <Img id={p.cover.id} alt="" ratio={coverFrame} focus={p.cover.focus} i={k % 3} sizes="(min-width: 1100px) 31vw, (min-width: 700px) 46vw, 92vw" />
          <span class="wg__over" aria-hidden="true">
            <span class="label wg__over-go">{ui.viewProject[lang]} <span class="arrow">{fwd(lang)}</span></span>
          </span>
        </span>
        <span class="wg__cap">
          <H class="wg__name" transition:name={`title-${p.slug}`}>{p.title[lang]}</H>
          <span class="label wg__year">{p.year}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .wg { display: grid; gap: var(--s-7) var(--gutter); }
  @media (min-width: 700px) { .wg { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .wg { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .wg__card { display: grid; gap: var(--s-3); }
  .wg__card:focus-visible { outline: 2px solid var(--signal); outline-offset: 6px; }

  /* the cover, and the action that comes up over it once it darkens */
  .wg__media { position: relative; display: block; overflow: hidden; }
  .wg__media :global(img) { transition: filter 0.6s var(--ease-out); }
  .wg__over {
    position: absolute; inset: 0; z-index: 2;
    display: grid; place-content: center; justify-items: center; gap: var(--s-3);
    padding: var(--s-5); text-align: center; pointer-events: none;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.45s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .wg__over-go { color: var(--ink); font-size: 0.875rem; }
  .wg__over-go .arrow { color: var(--wa); }

  /* the name centred under its cover, the year quietly beneath it */
  .wg__cap { display: grid; justify-items: center; gap: var(--s-1); text-align: center; }
  .wg__name { font-size: var(--t-lead); font-weight: 600; line-height: 1.25; }
  .wg__year { color: var(--ink-3); }

  @media (hover: hover) {
    .wg__card:hover .wg__media :global(img) { filter: brightness(0.3) saturate(0.85); }
    .wg__card:hover .wg__over { opacity: 1; transform: none; }
  }
  .wg__card:focus-visible .wg__media :global(img) { filter: brightness(0.3) saturate(0.85); }
  .wg__card:focus-visible .wg__over { opacity: 1; transform: none; }
</style>
