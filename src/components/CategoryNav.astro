---
// The category links on /work/ and on every category page: "All" plus one link per category.
// Plain links to real pages (shareable, the back button works, crawlable) rather than a JS filter. The row wraps
// instead of scrolling, so no category is ever hidden.
import { categories } from '../data/projects';
import { ui, url, type Lang } from '../i18n';

interface Props { lang: Lang; current?: string } // current: a category slug; none = "All"
const { lang, current } = Astro.props;
const links = [
  { href: url(lang, '/work/'), label: ui.allWork[lang], active: !current },
  ...categories.map((c) => ({ href: url(lang, `/work/${c.slug}/`), label: c.title[lang], active: current === c.slug })),
];
---
<nav class="cnav" aria-label={ui.categories[lang]}>
  <ul role="list">
    {links.map((l) => (
      <li>
        <a href={l.href} class="cnav__link" aria-current={l.active ? 'page' : undefined}>
          <span class="cnav__t">{l.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .cnav ul { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-6); }
  .cnav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-lead);
    line-height: 1.1;
    color: var(--ink-3);
    transition: color var(--d-base) var(--ease-out);
  }
  .cnav__t {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--d-base) var(--ease-out);
  }
  .cnav__link:hover { color: var(--ink); }
  /* the current page: full ink plus a signal-colour underline, so it never relies on colour alone */
  .cnav__link[aria-current='page'] { color: var(--ink); }
  .cnav__link[aria-current='page'] .cnav__t { text-decoration-color: var(--signal); }
</style>
