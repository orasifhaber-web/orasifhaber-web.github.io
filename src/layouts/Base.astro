---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/karantina/hebrew-700.css';
import '@fontsource/ibm-plex-sans-hebrew/400.css';
import '@fontsource/ibm-plex-sans-hebrew/600.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { ui, url, dir, basePath, langs, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  accent?: string;
  jsonld?: Record<string, unknown>;
  type?: 'website' | 'article';
}
const { lang, title, description = ui.description[lang], image = '/og.jpg', accent, jsonld, type = 'website' } = Astro.props;
const name = ui.name[lang];
const fullTitle = title ? `${title} — ${name}` : `${name} — ${ui.role[lang]}`;
const path = basePath(Astro.url.pathname);
const canonical = new URL(url(lang, path), Astro.site);
const ogImage = new URL(image, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: ui.name.he,
  jobTitle: ui.role[lang],
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  sameAs: site.social.map((s) => s.href),
};
---
<!doctype html>
<html lang={lang} dir={dir(lang)} style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(url(l, path), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(url('he', path), Astro.site)} />
    <meta name="theme-color" content="#0e0e0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonld ?? person)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter fallback="swap" />
  </head>
  <body id="top">
    <a class="skip" href="#main">{ui.skip[lang]}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Contact lang={lang} />
    <Footer lang={lang} />

    <script>
      // Scroll reveals — content stays visible without JS (the .js class gates the hidden state).
      // IntersectionObserver does the work; a throttled position check on scroll/resize is a safety net
      // so nothing can stay hidden if the observer is delayed or never fires.
      let pending: HTMLElement[] = [];
      let io: IntersectionObserver | undefined;
      const show = (e: Element) => { e.classList.add('in'); io?.unobserve(e); };
      function sweep() {
        const limit = innerHeight * 0.95;
        pending = pending.filter((e) => {
          const r = e.getBoundingClientRect();
          if (r.top < limit && r.bottom > 0) { show(e); return false; }
          return !e.classList.contains('in');
        });
      }
      let t = 0;
      const onScroll = () => { if (!t) t = window.setTimeout(() => { t = 0; sweep(); }, 120); };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });

      function initReveal() {
        io?.disconnect();
        pending = [...document.querySelectorAll<HTMLElement>('[data-reveal]:not(.in)')];
        if ('IntersectionObserver' in window) {
          io = new IntersectionObserver(
            (entries) => entries.forEach((en) => en.isIntersecting && show(en.target)),
            { rootMargin: '0px 0px -5% 0px', threshold: 0 },
          );
          pending.forEach((e) => io!.observe(e));
        }
        sweep();
        setTimeout(sweep, 400);
      }

      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
