---
// Fixed case-study template, the same for every project:
// hero → cover → overview → details (when the project has them) → gallery → next project.
import '@fontsource/pirata-one/400.css';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Gallery from '../components/Gallery.astro';
import { projects, type Project } from '../data/projects';
import { site } from '../data/site';
import { ui, url, fwd, back, type Lang } from '../i18n';

interface Props { lang: Lang; p: Project }
const { lang, p } = Astro.props;
const n = projects.indexOf(p);
const next = projects[(n + 1) % projects.length];
const prev = projects[(n - 1 + projects.length) % projects.length];
const L = <K extends { he: string; en: string }>(x: K) => x[lang];

const meta = [
  [ui.meta.client, L(p.client)],
  [ui.meta.year, p.year],
  [ui.meta.discipline, p.discipline.map(L).join(', ')],
  [ui.meta.tools, p.tools.join(', ')],
] as const;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: L(p.title),
  description: L(p.subtitle),
  inLanguage: lang,
  creator: { '@type': 'Person', name: site.name },
  dateCreated: p.year,
  image: new URL(`/img/${p.hero.id}-1280.webp`, Astro.site).toString(),
  keywords: p.discipline.map(L).join(', '),
};
const ink = (hex: string) => {
  const v = parseInt(hex.slice(1), 16);
  return 0.299 * ((v >> 16) & 255) + 0.587 * ((v >> 8) & 255) + 0.114 * (v & 255) > 150 ? '#0e0e0c' : '#edeae3';
};
---
<Base lang={lang} title={L(p.title)} description={`${L(p.subtitle)}. ${L(p.intro[0])}`.slice(0, 158)} image={`/img/${p.hero.id}-1280.webp`} accent={p.accent} jsonld={jsonld} type="article">
  <article class="project">
    <header class="p-hero wrap">
      <nav class="p-hero__crumbs label" aria-label={ui.breadcrumb[lang]}>
        <a href={url(lang, '/') + '#work'} class="link">{ui.work[lang]}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{String(n + 1).padStart(2, '0')} {ui.of[lang]} {projects.length}</span>
      </nav>
      <h1 class="h1 p-hero__title" transition:name={`title-${p.slug}`}>{L(p.title)}</h1>
      <p class="lead p-hero__sub" data-reveal>{L(p.subtitle)}</p>
      <dl class="p-meta" data-reveal style="--i:1">
        {meta.map(([k, v]) => (<div><dt class="label">{k[lang]}</dt><dd>{v}</dd></div>))}
      </dl>
    </header>

    <div class="p-cover">
      <Img id={p.hero.id} alt={L(p.hero.alt)} eager reveal={false} sizes="100vw" class="p-cover__img" />
    </div>

    <section class="p-sec wrap grid" aria-labelledby="overview">
      <h2 id="overview" class="label p-sec__label">{ui.overview[lang]}</h2>
      <div class="p-sec__body">
        {p.intro.map((x, k) => <p class:list={[k === 0 ? 'lead' : 'prose']} data-reveal style={`--i:${k}`}>{L(x)}</p>)}
        <a class="label link" href={p.behance} target="_blank" rel="noopener">{ui.behance[lang]} <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>

    {p.details && (
      <section class="p-details wrap" aria-label={lang === 'he' ? 'פרטים' : 'Details'}>
        {p.details.map((dt) => (
          <div class="p-detail grid">
            <h2 class="label p-sec__label" data-reveal>{L(dt.label)}</h2>
            <div class="p-sec__body">
              <p class="prose" data-reveal style="--i:1">{L(dt.body)}</p>
              {dt.colors && (
                <ul class="swatches" role="list">
                  {dt.colors.map((c, k) => <li data-reveal style={`--i:${k};background:${c};color:${ink(c)}`}><span class="label" style="color:inherit" dir="ltr">{c}</span></li>)}
                </ul>
              )}
            </div>
          </div>
        ))}
      </section>
    )}

    <section class="p-gallery" aria-labelledby="gallery">
      <h2 id="gallery" class="label wrap p-gallery__label">{ui.gallery[lang]}</h2>
      <Gallery items={p.gallery} lang={lang} />
    </section>

    <nav class="p-next" aria-label={ui.moreProjects[lang]}>
      <a href={url(lang, `/work/${next.slug}/`)} class="p-next__link wrap" style={`--next-accent:${next.accent}`}>
        <span class="label">{ui.next[lang]}</span>
        <span class="p-next__row">
          <span class="display p-next__title">{L(next.title)}</span>
          <span class="p-next__thumb"><Img id={next.cover.id} alt="" sizes="320px" reveal={false} ratio="4 / 5" /></span>
        </span>
        <span class="muted">{L(next.subtitle)}</span>
      </a>
      <div class="wrap p-next__aux">
        <a href={url(lang, `/work/${prev.slug}/`)} class="label link"><span aria-hidden="true">{back(lang)}</span> {L(prev.title)}</a>
        <a href={url(lang, '/') + '#work'} class="label link">{ui.allProjects[lang]} <span aria-hidden="true">{fwd(lang)}</span></a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .p-hero { padding-top: clamp(96px, 14vh, 160px); padding-bottom: var(--s-7); display: grid; gap: var(--s-5); }
  .p-hero__crumbs { display: flex; gap: var(--s-3); align-items: center; }
  .p-hero__crumbs .link { min-height: 0; }
  .p-hero__title { overflow-wrap: anywhere; }
  .p-hero__sub { max-width: 34ch; }
  .p-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--gutter); margin-top: var(--s-5); padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .p-meta dt { margin-bottom: var(--s-1); }
  .p-meta dd { font-size: var(--t-small); }
  .p-meta div:first-child dd { color: var(--accent); }
  @media (min-width: 900px) { .p-meta { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .p-cover { max-height: 92svh; overflow: hidden; }
  .p-cover :global(.p-cover__img) { max-height: 92svh; aspect-ratio: auto !important; }
  .p-cover :global(.p-cover__img img) { max-height: 92svh; object-fit: contain; margin-inline: auto; width: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .p-cover :global(img) { animation: cover-in 1.4s var(--ease-out) both; }
    @keyframes cover-in { from { clip-path: inset(12% 8% 12% 8%); transform: scale(1.06); } to { clip-path: inset(0); transform: none; } }
  }

  .p-sec, .p-detail { row-gap: var(--s-4); }
  .p-sec { padding-block: var(--section) var(--s-8); }
  .p-sec__label, .p-sec__body { grid-column: 1 / -1; }
  .p-sec__body { display: grid; gap: var(--s-5); max-width: 820px; }
  .p-sec__body .link { justify-self: start; }
  .p-details { display: grid; gap: var(--s-7); padding-bottom: var(--s-8); }
  .p-detail { padding-top: var(--s-5); border-top: 1px solid var(--line); }
  @media (min-width: 900px) {
    .p-sec__label { grid-column: 1 / span 3; padding-top: 0.6em; }
    .p-sec__body { grid-column: 4 / span 8; }
    .p-detail .p-sec__label { padding-top: 0.2em; }
  }
  .swatches { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .swatches li { aspect-ratio: 1; display: flex; align-items: flex-end; padding: var(--s-2); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  @media (max-width: 599px) { .swatches .label { font-size: 0.625rem; } }

  .p-gallery { padding-top: var(--s-5); }
  .p-gallery__label { display: block; padding-bottom: var(--s-5); }

  .p-next { margin-top: var(--section); border-top: 1px solid var(--line); }
  .p-next__link { display: grid; gap: var(--s-4); padding-block: var(--s-8) var(--s-6); }
  .p-next__row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); }
  .p-next__title { transition: color var(--d-base) var(--ease-out), transform var(--d-base) var(--ease-out); }
  .p-next__thumb { width: clamp(88px, 14vw, 220px); flex: none; transition: transform var(--d-slow) var(--ease-out); }
  .p-next__link:hover .p-next__title, .p-next__link:focus-visible .p-next__title { color: var(--next-accent); }
  .p-next__link:hover .p-next__thumb { transform: rotate(-3deg) scale(1.04); }
  .p-next__aux { display: flex; justify-content: space-between; gap: var(--s-4); padding-bottom: var(--s-6); }
</style>
