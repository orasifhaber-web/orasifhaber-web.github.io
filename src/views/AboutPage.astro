---
// "About me" — the same content as before (Or's CV, 2026; non-design jobs left out on purpose), laid out to be read
// at a glance and to lead somewhere:
//  1. opening — the portrait (the same interactive one as the home page), the headline, the first line, two buttons;
//  2. facts — what he does now, where he studied, who he has worked with (all taken from the content below);
//  3. the story — the remaining paragraphs in one readable column, beside the Trance Tribe stand;
//  4. what I do — the services, unnumbered, each leading to its category in the portfolio;
//  5. background and tools, together.
// Each part has its own tone and melts into the next; the light line marks the step into the contact form.
// The texts live in content/about.json and content/ui.json — editable in Pages CMS (see .pages.yml).
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import PortraitReveal from '../components/PortraitReveal.astro';
import { categories } from '../data/projects';
import { site } from '../data/site';
import { ui, url, fwd, type Lang, type T } from '../i18n';
import about from '../content/about.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (x: T) => x[lang];

const copy = about;
const services = about.services.map((s) => ({
  title: s.title,
  body: s.body,
  cat: categories.find((c) => c.slug === ('category' in s ? s.category : '')),
}));
const background = about.background.map((b) => ({
  when: L(b.when),
  title: b.title,
  body: b.body,
  href: 'link' in b && b.link ? url(lang, b.link) : undefined,
}));
// the facts strip: the two dated lines of the background (now, studies), then who he has worked with
const facts = background.filter((b) => /\d/.test(b.when)).slice(0, 2);
---
<Base lang={lang} title={L(copy.label)} description={`${L(copy.p1)} ${L(copy.p2)}`.slice(0, 158)}>
  <div class="ab">
    <!-- 1. opening -->
    <section class="ab-open wrap" aria-labelledby="ab-title">
      <div class="ab-open__text">
        <p class="label">{L(copy.label)}</p>
        <h1 id="ab-title" class="h1 ab-open__title">{L(copy.title)}</h1>
        <p class="lead ab-open__lead">{L(copy.p1)}</p>
        <div class="ab-open__cta">
          <a href={url(lang, '/') + '#work'} class="btn btn--primary">{ui.hero.toWork[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a>
          <a href="#contact" class="btn btn--ghost">{ui.hero.toContact[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a>
        </div>
      </div>
      <PortraitReveal class="ab-open__portrait" alt={ui.hero.portrait[lang]} demo={false} />
    </section>

    <!-- 2. facts -->
    <section class="ab-facts" aria-label={L(copy.bgLabel)}>
      <dl class="wrap ab-facts__list">
        {facts.map((f) => (
          <div><dt class="label">{f.when}</dt><dd>{L(f.title)}</dd></div>
        ))}
        <div><dt class="label">{ui.about.workedWith[lang]}</dt><dd>{site.workedWith.join(' · ')}</dd></div>
      </dl>
    </section>

    <!-- 3. the story -->
    <section class="ab-story ab-tone" style="--from:#0e0e0c;--to:#201e19" aria-label={L(copy.label)}>
      <div class="wrap grid ab-story__grid">
        <div class="prose ab-story__text">
          <p data-reveal>{L(copy.p2)}</p>
          <p data-reveal style="--i:1">{L(copy.p3)}</p>
          <p data-reveal style="--i:2">{L(copy.p4)}</p>
        </div>
        <figure class="ab-story__media lit">
          <Img id="09/10" alt={L(copy.imgAlt)} sizes="(min-width: 900px) 36vw, 92vw" />
        </figure>
      </div>
    </section>

    <!-- 4. what I do -->
    <section class="ab-do ab-tone" style="--from:#201e19;--to:#12110e" aria-labelledby="ab-do-title">
      <div class="wrap">
        <h2 id="ab-do-title" class="h2 ab-do__title">{L(copy.whatLabel)}</h2>
        <ul class="ab-do__list" role="list">
          {services.map((s, n) => (
            <li data-reveal style={`--i:${n}`}>
              <h3 class="h3">{L(s.title)}</h3>
              <p class="muted">{L(s.body)}</p>
              {s.cat && <a href={url(lang, `/work/${s.cat.slug}/`)} class="label link">{s.cat.title[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. background and tools -->
    <section class="ab-cv ab-tone" style="--from:#12110e;--to:#0e0e0c" aria-label={`${L(copy.bgLabel)} · ${L(copy.toolsLabel)}`}>
      <div class="wrap ab-cv__grid">
        <div>
          <h2 class="label ab-cv__label">{L(copy.bgLabel)}</h2>
          <dl class="ab-cv__items">
            {background.map((b) => (
              <div data-reveal>
                <dt class="label">{b.when}</dt>
                <dd>
                  <strong>{b.href ? <a href={b.href} class="link">{L(b.title)} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a> : L(b.title)}</strong>
                  <span class="muted">{L(b.body)}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h2 class="label ab-cv__label">{L(copy.toolsLabel)}</h2>
          <dl class="ab-cv__items ab-cv__tools">
            {about.tools.map((x) => (<div data-reveal><dt class="label">{L(x.label)}</dt><dd dir="ltr">{x.value}</dd></div>))}
          </dl>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* each part melts out of the tone before it (--from) into its own (--to) */
  .ab-tone { background: linear-gradient(to bottom, var(--from), var(--to) 180px) var(--to); }

  /* ---------- 1. opening ---------- */
  .ab-open { display: grid; gap: var(--s-6); padding-top: var(--page-top); padding-bottom: var(--s-8); }
  .ab-open__text { display: grid; gap: var(--s-5); align-content: center; justify-items: start; }
  .ab-open__title { max-width: 16ch; }
  .ab-open__lead { max-width: 34ch; }
  .ab-open__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .ab-open :global(.portrait.ab-open__portrait) { position: relative; width: min(86vw, 460px); justify-self: center; background: none; }
  /* the photo is cropped at the shoulders: blend that edge into the page */
  .ab-open :global(.portrait.ab-open__portrait)::after {
    content: ''; position: absolute; inset: auto 0 -1px; height: 26%; z-index: 3; pointer-events: none;
    background: linear-gradient(to bottom, rgb(14 14 12 / 0), var(--bg) 92%);
  }
  @media (min-width: 900px) {
    .ab-open { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; min-height: 92svh; padding-bottom: 0; }
    .ab-open__text { padding-bottom: var(--s-9); }
    .ab-open :global(.portrait.ab-open__portrait) { width: 100%; max-width: 520px; justify-self: end; }
  }

  /* ---------- 2. facts ---------- */
  .ab-facts { border-block: 1px solid var(--line); }
  .ab-facts__list { display: grid; gap: var(--s-5); padding-block: var(--s-6); }
  .ab-facts__list div { display: grid; gap: var(--s-2); align-content: start; }
  .ab-facts__list dd { font-size: var(--t-lead); line-height: 1.3; color: var(--ink); }
  @media (min-width: 900px) {
    .ab-facts__list { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); }
    .ab-facts__list div + div { padding-inline-start: var(--gutter); border-inline-start: 1px solid var(--line); }
  }

  /* ---------- 3. the story ---------- */
  .ab-story { padding-block: var(--section); }
  .ab-story__grid { row-gap: var(--s-7); }
  .ab-story__text, .ab-story__media { grid-column: 1 / -1; }
  .ab-story__text { font-size: 1.125rem; line-height: 1.7; color: var(--ink-2); }
  .ab-story__media { margin: 0; }
  @media (min-width: 900px) {
    .ab-story__text { grid-column: 1 / span 6; align-self: center; }
    .ab-story__media { grid-column: 8 / -1; position: sticky; top: 96px; align-self: start; }
  }

  /* ---------- 4. what I do ---------- */
  .ab-do { padding-block: var(--section); }
  .ab-do__title { margin-bottom: var(--s-7); }
  .ab-do__list { display: grid; gap: var(--s-5) var(--gutter); }
  .ab-do__list li { display: grid; gap: var(--s-3); align-content: start; padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .ab-do__list .muted { max-width: 44ch; }
  .ab-do__list .link { justify-self: start; margin-top: var(--s-2); }
  @media (min-width: 700px) { .ab-do__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .ab-do__list { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--s-7); } }

  /* ---------- 5. background and tools ---------- */
  .ab-cv { padding-block: var(--section); }
  .ab-cv__grid { display: grid; gap: var(--s-8); }
  .ab-cv__label { margin-bottom: var(--s-4); }
  .ab-cv__items > div { display: grid; gap: var(--s-2); padding-block: var(--s-4); border-top: 1px solid var(--line); }
  .ab-cv__items dd { display: grid; gap: var(--s-2); max-width: 60ch; }
  .ab-cv__items dd strong { font-weight: 600; }
  .ab-cv__items .link { min-height: 0; }
  .ab-cv__tools dd { color: var(--ink); }
  :global([dir='rtl']) .ab-cv__tools dd { text-align: right; }
  @media (min-width: 900px) {
    .ab-cv__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--s-9); }
    .ab-cv__items > div { grid-template-columns: 9rem 1fr; gap: var(--gutter); }
  }
</style>
