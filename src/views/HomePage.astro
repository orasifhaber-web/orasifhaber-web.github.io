---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import PortraitReveal from '../components/PortraitReveal.astro';
import { site } from '../data/site';
import { ui, url, fwd, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const [l1, l2] = ui.nameLines[lang];
---
<Base lang={lang}>
  <!-- Poster hero: the cut-out portrait stands beside (and slightly in front of) the name; hover / tap reveals the artworks -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__top label">
      <span>{ui.role[lang]} — {ui.location[lang]}</span>
      <span class="hero__years">{ui.hero.years[lang]}</span>
    </div>
    <h1 id="hero-title" class="mega hero__name">
      <span class="hero__line"><span>{l1}</span></span><span class="hero__sp"> </span><span class="hero__line"><span>{l2}</span></span>
    </h1>
    <PortraitReveal class="hero__portrait" alt={ui.hero.portrait[lang]} />
    <div class="hero__bottom">
      <p class="hero__statement">{ui.hero.statement[lang]}</p>
      <ul class="hero__cta">
        <li><a href="#work" class="label link">{ui.hero.toWork[lang]} <span class="arrow" aria-hidden="true">↓</span></a></li>
        <li><a href="#contact" class="label link">{ui.hero.toContact[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a></li>
      </ul>
    </div>
  </section>

  <WorkList lang={lang} />

  <section class="about-pre section wrap grid" aria-labelledby="about-pre-title">
    <h2 id="about-pre-title" class="label about-pre__label">{ui.about.label[lang]}</h2>
    <div class="about-pre__body">
      <p class="lead" data-reveal>{ui.about.preview[lang]}</p>
      <a href={url(lang, '/about/')} class="label link" data-reveal style="--i:1">{ui.about.more[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a>
    </div>
    <div class="about-pre__with">
      <p class="label">{ui.about.workedWith[lang]}</p>
      <ul class="about-pre__list" role="list">
        {site.workedWith.map((w, n) => <li data-reveal style={`--i:${n}`}>{w}</li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero (poster) ----------
     Phone / tablet: name on two lines, the portrait below it rising a little into the second line, then the text.
     Desktop: the portrait fills the height in its own column, flush with the right edge of the screen (where the photo is
     cropped), below the fixed header; labels, name, statement and links sit together as one block beside it. */
  .hero {
    position: relative;
    display: grid;
    overflow: hidden;
    padding-top: 88px;
  }
  .hero__top { display: flex; justify-content: space-between; gap: var(--s-4); padding-inline: var(--margin); position: relative; z-index: 3; }
  .hero__years { display: none; }
  .hero__name { position: relative; z-index: 1; font-size: 22vw; padding-inline: var(--margin); margin-top: var(--s-5); }
  :global([lang='he']) .hero__name { font-size: 30vw; line-height: 0.82; }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.02em; }
  .hero__line > span { display: block; }
  .hero__sp { display: none; }
  /* the PNG is a cut-out on a transparent background; fade its cropped bottom edge into the page */
  .hero :global(.portrait.hero__portrait) {
    position: relative;
    z-index: 2;
    width: min(92vw, 520px);
    margin: -9vw auto 0;
    background: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
    mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
  }
  .hero__bottom { position: relative; z-index: 3; display: grid; gap: var(--s-5); padding: var(--s-6) var(--margin) var(--s-8); }
  .hero__statement { font-size: clamp(1.25rem, 2.3vw, 2.2rem); line-height: 1.25; letter-spacing: -0.015em; max-width: 30ch; font-variation-settings: 'wdth' 92; }
  :global([lang='he']) .hero__statement { letter-spacing: 0; line-height: 1.35; }
  .hero__cta { display: flex; gap: var(--s-6); }

  @media (min-width: 900px) {
    .hero {
      --tuck: 4vw; /* how far the name runs in behind the portrait */
      min-height: 100svh;
      --fig-w: calc((100svh - 72px) * 1086 / 1448); /* the portrait's width follows the screen height */
      padding-top: 0;
      /* minmax(0, …): a long name never pushes the portrait off screen — it only slides further behind it */
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto 1fr auto auto 1fr;
      grid-template-areas: 'fig top' 'fig .' 'fig name' 'fig bottom' 'fig .';
    }
    /* English reads left to right, but the portrait stays on the right, where the photo is cropped */
    :global([dir='ltr']) .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'top fig' '. fig' 'name fig' 'bottom fig' '. fig';
    }
    .hero :global(.portrait.hero__portrait) {
      grid-area: fig;
      align-self: end;
      width: auto;
      height: calc(100svh - 72px); /* starts below the fixed header */
      aspect-ratio: 1086 / 1448;
      margin: 0;
    }
    .hero__top { grid-area: top; padding: 88px var(--margin) 0; padding-right: var(--s-6); }
    .hero__years { display: inline; }
    .hero__name { grid-area: name; display: flex; white-space: nowrap; margin: 0 calc(-1 * var(--tuck)) 0 0; padding: 0 0 0 var(--margin); }
    .hero__line { flex-shrink: 0; } /* keep each line whole; the overflow tucks behind the portrait */
    /* English reads from the left edge, so its size is set to span the free width up to the portrait
       (5.35 = width of "OR ASIF-HABER" in ems); Hebrew starts right at the portrait and keeps a fixed size */
    :global([lang='en']) .hero__name { font-size: calc((100vw - var(--fig-w) - var(--margin) + var(--tuck) - 24px) / 5.35); }
    :global([lang='he']) .hero__name { font-size: 11.5vw; }
    :global([lang='he']) .hero__sp { display: block; width: 0.22em; }
    .hero__bottom { grid-area: bottom; justify-items: start; padding: var(--s-6) var(--s-6) 0 var(--margin); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line > span { animation: rise 1.1s var(--ease-out) both; }
    .hero__line:last-child > span { animation-delay: 90ms; }
    .hero__bottom, .hero__top { animation: fade 1s 350ms var(--ease-out) both; }
    .hero :global(.hero__portrait) { animation: fade-in 1.2s 150ms var(--ease-out) both; }
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
    @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  }

  .about-pre { row-gap: var(--s-6); }
  :where(.about-pre > *) { grid-column: 1 / -1; }
  .about-pre__body { display: grid; gap: var(--s-5); max-width: 860px; }
  .about-pre__body .link { justify-self: start; }
  .about-pre__list { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-3); font-family: var(--f-display); font-weight: 700; font-variation-settings: 'wdth' 62; text-transform: uppercase; font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1; }
  .about-pre__list li:not(:last-child)::after { content: '/'; margin-inline-start: var(--s-5); color: var(--ink-3); font-weight: 400; }
  @media (min-width: 900px) {
    .about-pre__label { grid-column: 1 / span 3; padding-top: 0.6em; }
    .about-pre__body, .about-pre__with { grid-column: 4 / span 9; }
  }
</style>
