---
import Base from '../layouts/Base.astro';
import CategoryWheel from '../components/CategoryWheel.astro';
import PortraitReveal from '../components/PortraitReveal.astro';
import HeroCosmos from '../components/HeroCosmos.astro';
import { site } from '../data/site';
import { ui, url, fwd, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const [l1, l2] = ui.nameLines[lang];
---
<Base lang={lang}>
  <!-- The home page as stacked "pages": each one rises over the one before, in its own tone, while the one beneath dims
       and sinks back a little — and each arrives its own way (data-enter, see the script below). -->
  <div class="hp">
  <!-- Poster hero: the cut-out portrait stands beside (and slightly in front of) the name; hover / tap reveals the artworks -->
  <section class="hero hp__panel hp__panel--stick" aria-labelledby="hero-title">
    <div class="hero__top label">
      <span>{ui.role[lang]} — {ui.location[lang]}</span>
      <span class="hero__years">{ui.hero.years[lang]}</span>
    </div>
    <h1 id="hero-title" class="mega hero__name">
      <span class="hero__line"><span>{l1}</span></span><span class="hero__sp"> </span><span class="hero__line"><span>{l2}</span></span>
    </h1>
    <HeroCosmos class="hero__space" />
    <PortraitReveal class="hero__portrait" alt={ui.hero.portrait[lang]} demoDelay={2400} />
    <div class="hero__bottom">
      <p class="hero__statement">{ui.hero.statement[lang]}</p>
      <ul class="hero__cta">
        <li><a href="#work" class="btn btn--primary">{ui.hero.toWork[lang]} <span class="arrow" aria-hidden="true">↓</span></a></li>
        <li><a href="#contact" class="btn btn--ghost">{ui.hero.toContact[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a></li>
      </ul>
    </div>
    <div class="hp__shade" aria-hidden="true"></div>
  </section>

  <!-- the work: a wheel of categories, one card each (not every project at once) -->
  <section id="work" class="hp__panel hp__panel--stick hp__work" data-enter="melt" aria-labelledby="work-title">
    <div class="wrap"><CategoryWheel lang={lang} /></div>
    <a href="#about" class="label hp__next">{ui.about.label[lang]} <span aria-hidden="true">↓</span></a>
    <div class="hp__shade" aria-hidden="true"></div>
  </section>
  <!-- a short pause: the portfolio stays put while it eases away (drifts up, dims a touch) before the next page rises -->
  <div class="hp__dwell" aria-hidden="true"></div>

  <section id="about" class="about-pre hp__panel hp__about section wrap grid" data-enter="tilt" aria-labelledby="about-pre-title">
    <h2 id="about-pre-title" class="label about-pre__label">{ui.about.label[lang]}</h2>
    <div class="about-pre__body">
      <p class="lead" data-reveal>{ui.about.preview[lang]}</p>
      <a href={url(lang, '/about/')} class="btn btn--ghost" data-reveal style="--i:1">{ui.about.more[lang]} <span class="arrow" aria-hidden="true">{fwd(lang)}</span></a>
    </div>
    <div class="about-pre__with">
      <p class="label">{ui.about.workedWith[lang]}</p>
      <ul class="about-pre__list" role="list">
        {site.workedWith.map((w, n) => <li data-reveal style={`--i:${n}`}>{w}</li>)}
      </ul>
    </div>
  </section>
  </div>
</Base>

<script>
  // Stacked pages: a panel that is taller than the screen sticks by its foot, so all of it can be read before the next
  // one covers it; as the next panel rises, the one beneath dims and sinks back a little (scrubbed to the scroll).
  // Each page arrives its own way, scrubbed too:
  //  · melt — opening → portfolio: the page slides up with a soft, feathered top edge that melts into the opening,
  //    and the wheel inside floats up a little and fades in; done by 80% of the way, so it is whole while it settles;
  //  · tilt — portfolio → about: the page rises with a gently slanted edge, high on the reading side, that levels out.
  // After the portfolio comes a short pause (.hp__dwell): it stays in place, still usable, but answers the scroll —
  // the wheel drifts up a little and dims a touch, the cue below it fades — so scrolling never looks like nothing.
  // Nothing moves or clips with reduced motion; everything is undone before a page swap.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  let mm: gsap.MatchMedia | undefined;
  let ro: ResizeObserver | undefined;

  const setup = () => {
    const panels = [...document.querySelectorAll<HTMLElement>('.hp__panel--stick')];
    if (!panels.length) return;
    const stick = () => panels.forEach((p) => { p.style.top = `${Math.min(0, innerHeight - p.offsetHeight)}px`; });
    ro = new ResizeObserver(() => { stick(); ScrollTrigger.refresh(); });
    panels.forEach((p) => ro!.observe(p));
    stick();

    mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      panels.forEach((p) => {
        let next = p.nextElementSibling as HTMLElement | null;
        while (next && !next.classList.contains('hp__panel')) next = next.nextElementSibling as HTMLElement | null;
        if (!next) return;
        gsap.timeline({ scrollTrigger: { trigger: next, start: 'top bottom', end: 'top top', scrub: true } })
          .to(p.querySelector('.hp__shade'), { opacity: 0.45, ease: 'none' }, 0)
          .to(p, { scale: 0.97, ease: 'none' }, 0);
      });

      const dwell = document.querySelector<HTMLElement>('.hp__dwell');
      const work = document.getElementById('work');
      if (dwell && work) {
        gsap.timeline({ scrollTrigger: { trigger: dwell, start: 'top bottom', end: 'bottom bottom', scrub: true } })
          .to(work.querySelector(':scope > .wrap'), { y: () => -innerHeight * 0.05, opacity: 0.82, ease: 'none' }, 0)
          .to(work.querySelector('.hp__next'), { opacity: 0, ease: 'none' }, 0);
      }

      const rtl = document.documentElement.dir === 'rtl';
      const inOut = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;
      const entrances: Record<string, (el: HTMLElement, t: number) => void> = {
        melt: (el, t) => {
          const k = inOut(Math.min(1, t / 0.8));
          // the top edge feathers over 260px at first and sharpens as the page settles
          const feather = (1 - k) * 260;
          el.style.maskImage = el.style.webkitMaskImage = k >= 1 ? '' : `linear-gradient(to bottom, transparent, #000 ${feather}px)`;
          const inner = el.querySelector<HTMLElement>(':scope > .wrap');
          if (inner) {
            inner.style.transform = k >= 1 ? '' : `translateY(${(1 - k) * 48}px)`;
            inner.style.opacity = k >= 1 ? '' : String(0.25 + 0.75 * k);
          }
        },
        tilt: (el, t) => {
          // the slanted leading edge: 12% lower on the far side at first, level by the end
          const drop = (1 - inOut(t)) * 12;
          el.style.clipPath = t >= 1 ? '' : rtl
            ? `polygon(0 ${drop}%, 100% 0, 100% 100%, 0 100%)`
            : `polygon(0 0, 100% ${drop}%, 100% 100%, 0 100%)`;
        },
      };
      const entering = [...document.querySelectorAll<HTMLElement>('.hp [data-enter]')];
      entering.forEach((el) => {
        const enter = entrances[el.dataset.enter!];
        if (!enter) return;
        el.classList.add(`is-${el.dataset.enter}`);
        const run = (self: ScrollTrigger) => enter(el, self.progress);
        ScrollTrigger.create({ trigger: el, start: 'top bottom', end: 'top top', onUpdate: run, onRefresh: run });
      });
      return () => entering.forEach((el) => {
        el.classList.remove(`is-${el.dataset.enter}`);
        el.style.clipPath = el.style.maskImage = el.style.webkitMaskImage = '';
        el.querySelector<HTMLElement>(':scope > .wrap')?.removeAttribute('style');
      });
    });
  };
  const teardown = () => { mm?.revert(); ro?.disconnect(); mm = undefined; ro = undefined; };

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', teardown);
</script>

<style>
  /* ---------- hero (poster) ----------
     Phone / tablet: name on two lines, the portrait below it rising a little into the second line, then the text.
     Desktop: the portrait fills the height in its own column, flush with the right edge of the screen (where the photo is
     cropped), below the fixed header; labels, name, statement and links sit together as one block beside it. */
  .hero {
    position: relative;
    display: grid;
    overflow: hidden;
    padding-top: 88px;
  }
  .hero__top { display: flex; justify-content: space-between; gap: var(--s-4); padding-inline: var(--margin); position: relative; z-index: 3; }
  .hero__years { display: none; }
  .hero__name { position: relative; z-index: 1; font-size: 22vw; padding-inline: var(--margin); margin-top: var(--s-5); }
  :global([lang='he']) .hero__name { font-size: 30vw; line-height: 0.82; }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.02em; }
  .hero__line > span { display: block; }
  .hero__sp { display: none; }
  /* the PNG is a cut-out on a transparent background */
  .hero :global(.portrait.hero__portrait) {
    position: relative;
    z-index: 2;
    width: min(92vw, 520px);
    margin: -9vw auto 0;
    background: none;
  }
  /* the photo has its own dark backdrop: its sides and top fade out, so no rectangle shows against the stars */
  .hero :global(.portrait.hero__portrait) {
    -webkit-mask: linear-gradient(to right, transparent, #000 16%, #000 84%, transparent), linear-gradient(to bottom, transparent, #000 12%);
    -webkit-mask-composite: source-in;
    mask: linear-gradient(to right, transparent, #000 16%, #000 84%, transparent) intersect, linear-gradient(to bottom, transparent, #000 12%);
  }
  /* the photo is cropped at the shoulders: blend that edge into the page colour. An opaque overlay, not a transparency
     mask — so nothing behind the portrait (the geometry) ever shows through the body. */
  .hero :global(.portrait.hero__portrait)::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 26%;
    z-index: 3;
    background: linear-gradient(to bottom, rgb(14 14 12 / 0), var(--bg) 92%);
    pointer-events: none;
  }
  /* deep space behind everything in the Hero: its vanishing point is the portrait's head, and it follows the mouse */
  .hero :global(.hero__space) {
    position: absolute;
    z-index: 0;
    inset: 0;
  }
  .hero__bottom { position: relative; z-index: 3; display: grid; gap: var(--s-5); padding: var(--s-6) var(--margin) var(--s-8); }
  .hero__statement { font-size: clamp(1.25rem, 2.3vw, 2.2rem); line-height: 1.25; letter-spacing: -0.015em; max-width: 30ch; font-variation-settings: 'wdth' 92; }
  :global([lang='he']) .hero__statement { letter-spacing: 0; line-height: 1.35; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  @media (max-width: 899px) {
    /* taller than the screen on a phone: it scrolls away normally instead of sticking with its top cut off */
    .hero.hp__panel--stick { position: relative; top: auto !important; }
    /* the two actions side by side, sharing the row equally */
    .hero__cta { flex-wrap: nowrap; }
    .hero__cta li { flex: 1 1 0; min-width: 0; }
    .hero__cta .btn { width: 100%; padding-inline: var(--s-3); gap: var(--s-2); font-size: 0.9375rem; white-space: nowrap; }
  }

  @media (min-width: 900px) {
    .hero {
      --tuck: 4vw; /* how far the name runs in behind the portrait */
      min-height: 100svh;
      --fig-w: calc((100svh - 72px) * 1086 / 1448); /* the portrait's width follows the screen height */
      padding-top: 0;
      /* minmax(0, …): a long name never pushes the portrait off screen — it only slides further behind it */
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto 1fr auto auto 1fr;
      grid-template-areas: 'fig top' 'fig .' 'fig name' 'fig bottom' 'fig .';
    }
    /* English reads left to right, but the portrait stays on the right, where the photo is cropped */
    :global([dir='ltr']) .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'top fig' '. fig' 'name fig' 'bottom fig' '. fig';
    }
    .hero :global(.portrait.hero__portrait) {
      -webkit-mask: linear-gradient(to right, transparent, #000 18%);
      mask: linear-gradient(to right, transparent, #000 18%);
      grid-area: fig;
      align-self: end;
      width: auto;
      height: calc(100svh - 72px); /* starts below the fixed header */
      aspect-ratio: 1086 / 1448;
      margin: 0;
    }
    .hero__top { grid-area: top; padding: 88px var(--margin) 0; padding-right: var(--s-6); }
    .hero__years { display: inline; }
    .hero__name { grid-area: name; display: flex; white-space: nowrap; margin: 0 calc(-1 * var(--tuck)) 0 0; padding: 0 0 0 var(--margin); }
    .hero__line { flex-shrink: 0; } /* keep each line whole; the overflow tucks behind the portrait */
    /* English reads from the left edge, so its size is set to span the free width up to the portrait
       (5.35 = width of "OR ASIF-HABER" in ems); Hebrew starts right at the portrait and keeps a fixed size */
    :global([lang='en']) .hero__name { font-size: calc((100vw - var(--fig-w) - var(--margin) + var(--tuck) - 24px) / 5.35); }
    :global([lang='he']) .hero__name { font-size: 11.5vw; }
    :global([lang='he']) .hero__sp { display: block; width: 0.22em; }
    .hero__bottom { grid-area: bottom; justify-items: start; padding: var(--s-6) var(--s-6) 0 var(--margin); }
  }

  /* The entrance — one orchestrated sequence, ~2.3s, in the site's light motif:
     the stars come up out of the dark → the portrait develops from below and switches on with a short flicker → the
     name rises line by line → the labels, the statement and the two buttons follow → the menu last. (The portrait's
     own "third eye" demo waits until it is over.) Reduced motion: everything is simply there. */
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero__space) { animation: fade-in 1.8s var(--ease-in-out) both; }
    .hero :global(.hero__portrait) { animation: develop 1.9s 0.2s linear both; }
    .hero__line > span { animation: rise 1.2s 0.6s var(--ease-out) both; }
    .hero__line:last-child > span { animation-delay: 0.74s; }
    .hero__top { animation: fade 1s 1.15s var(--ease-out) both; }
    .hero__statement { animation: fade 1s 1.3s var(--ease-out) both; }
    .hero__cta li { animation: fade 0.9s 1.5s var(--ease-out) both; }
    .hero__cta li + li { animation-delay: 1.62s; }
    :global(.hdr) { animation: fade-in 1s 1.7s var(--ease-out) both; }
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
    @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    /* develop: the picture rises out of the dark from below, then the light switches on — a short neon flicker */
    @keyframes develop {
      0% { clip-path: inset(100% 0 0 0); filter: brightness(0); }
      48% { clip-path: inset(0 0 0 0); filter: brightness(0.3); }
      60% { filter: brightness(0.95); }
      66% { filter: brightness(0.45); }
      75% { filter: brightness(1.08); }
      82% { filter: brightness(0.8); }
      100% { clip-path: inset(0 0 0 0); filter: brightness(1); }
    }
  }

  /* ---------- stacked pages ---------- */
  .hp__panel { position: relative; background: var(--bg); }
  .hp__panel--stick { position: sticky; top: 0; transform-origin: 50% 0; }
  .hp__shade { position: absolute; inset: 0; z-index: 20; background: #000; opacity: 0; pointer-events: none; }
  /* the pause after the portfolio: empty, see-through scroll room while the portfolio stays stuck in place */
  .hp__dwell { height: 40svh; pointer-events: none; }
  /* a quiet way on, at the foot of the portfolio */
  .hp__next {
    position: absolute; z-index: 2; left: 50%; bottom: var(--s-5); transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; padding-inline: var(--s-3);
    color: var(--ink-3); transition: color var(--d-base) var(--ease-out);
  }
  .hp__next:hover, .hp__next:focus-visible { color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .hp__next span { display: inline-block; animation: hp-nudge 2.6s var(--ease-in-out) infinite; }
    @keyframes hp-nudge { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(4px); } }
  }
  /* the work page: a stage of its own (the wheel lights it in the colour of the category at its centre) */
  .hp__work {
    /* "לתיק העבודות" (and the menu) land with the wheel flush at the top, fully in: cancel the page's 80px
       scroll-padding, which is there for headings under the fixed header — this page has its own top padding */
    scroll-margin-top: -80px;
    min-height: 100svh;
    display: grid; align-content: center;
    padding-block: calc(72px + var(--s-6)) calc(var(--s-7) + 44px);
    background: #12110e;
    overflow: hidden;
  }
  .hp__work > .wrap { position: relative; z-index: 1; }
  /* about me: a lighter, warmer surface than the black before it, so the page is seen rising from its first pixel */
  .hp__about { background: #201e19; z-index: 1; }

  .about-pre { row-gap: var(--s-6); }
  :where(.about-pre > *) { grid-column: 1 / -1; }
  .about-pre__body { display: grid; gap: var(--s-5); max-width: 860px; }
  .about-pre__body .btn { justify-self: start; }
  .about-pre__list { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-3); font-family: var(--f-display); font-weight: 700; font-variation-settings: 'wdth' 62; text-transform: uppercase; font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1; }
  .about-pre__list li:not(:last-child)::after { content: '/'; margin-inline-start: var(--s-5); color: var(--ink-3); font-weight: 400; }
  @media (min-width: 900px) {
    .about-pre__label { grid-column: 1 / span 3; padding-top: 0.6em; }
    .about-pre__body, .about-pre__with { grid-column: 4 / span 9; }
  }
</style>
