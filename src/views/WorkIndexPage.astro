---
// The whole portfolio: the category links, then each category in site order as a calm grid of covers — the same grid
// as the category pages. Reached from "All" in the category links.
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { categories, inCategory } from '../data/projects';
import { ui, url, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} title={ui.allProjects[lang]}>
  <section class="wi-hero wrap">
    <h1 class="h1">{ui.work[lang]}</h1>
    <CategoryNav lang={lang} />
  </section>

  {categories.map((c) => (
    <section class="wi-cat" aria-labelledby={`wi-${c.slug}`}>
      <div class="wrap wi-cat__head">
        <h2 id={`wi-${c.slug}`} class="h2">
          <a href={url(lang, `/work/${c.slug}/`)}>{c.title[lang]}</a>
        </h2>
        <p class="muted wi-cat__intro">{c.intro[lang]}</p>
      </div>
      <WorkGrid lang={lang} items={inCategory(c.slug)} />
    </section>
  ))}
</Base>

<style>
  .wi-hero { padding-top: var(--page-top); display: grid; gap: var(--s-6); }
  .wi-cat { padding-top: var(--section); }
  .wi-cat__head { display: grid; gap: var(--s-3); justify-items: start; padding-bottom: var(--s-6); }
  .wi-cat__head h2 a:hover { color: var(--signal); }
  .wi-cat__intro { max-width: 46ch; }
</style>
